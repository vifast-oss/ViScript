{
  "comments": { "lineComment": "#" },
  "brackets": [["{", "}"], ["[", "]"], ["(", ")"]],
  "autoClosingPairs": [
    { "open": "{", "close": "}" },
    { "open": "[", "close": "]" },
    { "open": "(", "close": ")" },
    { "open": "\"", "close": "\"" }
  ],
  "surroundingPairs": [["{", "}"], ["[", "]"], ["(", ")"], ["\"", "\""]],
  "indentationRules": {
    "increaseIndentPattern": "(:\\s*$|^\\s*(fn|if|else|for|while|match|impl|trait|type|record|enum|cmd|test|async)\\b.*:\\s*$)",
    "decreaseIndentPattern": "^\\s*(else|elif|catch)\\b"
  }
}
