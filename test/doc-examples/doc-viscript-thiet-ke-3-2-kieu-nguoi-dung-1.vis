# SPDX-License-Identifier: MIT OR Apache-2.0
type User derives Eq, Show, Json:
    name: str
    age: int
    email: str? = None

enum Shape derives Show:
    Circle(r: float)
    Rect(w: float, h: float)
    Empty

type UserId = int
type Email(str)                 # kiểu mới, không tự chuyển đổi với str
