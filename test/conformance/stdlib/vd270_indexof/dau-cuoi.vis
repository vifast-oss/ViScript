use std.list

fn main():
    let xs = [10, 20, 30, 20, 10]
    print(list.index_of(xs, 10))
    print(list.index_of(xs, 20))
    print(list.index_of(xs, 30))
    print(list.last_index_of(xs, 10))
    print(list.last_index_of(xs, 20))
    print(list.last_index_of(xs, 30))
