use std.list

type P:
    x: int
    y: int

fn main():
    let ps: list[P] = [{x: 1, y: 2}, {x: 3, y: 4}, {x: 1, y: 2}]
    print(list.index_of(ps, {x: 3, y: 4}))
    print(list.last_index_of(ps, {x: 1, y: 2}))
    print(list.index_of(ps, {x: 9, y: 9}))
