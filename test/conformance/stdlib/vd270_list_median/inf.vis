use std.list

fn main():
    let inf = 1.0 / 0.0
    print(list.median([inf, 1.0, 2.0]))
    print(list.median([1.0, inf, -inf]))
    print(list.median([-inf, 1.0, 2.0]))
    print(list.median([inf, inf, 1.0]))
    print(list.median([-inf, -inf, 1.0]))
    print(list.median([1.0, inf]))
    print(list.median([-inf, 1.0]))
    print(list.median([-inf, inf]))
    print(list.median([inf, inf]))
    print(list.median([-inf, -inf]))
