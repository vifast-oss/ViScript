use std.list

fn main():
    print(list.median([1.0, 2.0]))
    print(list.median([1.0, 2.0, 3.0, 4.0]))
    print(list.median([4.0, 1.0, 3.0, 2.0]))
    print(list.median([8.0, 7.0, 6.0, 5.0, 4.0, 3.0, 2.0, 1.0]))
    print(list.median([2.0, 2.0, 2.0, 2.0]))
