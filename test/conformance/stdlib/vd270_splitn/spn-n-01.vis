use std.str

fn main():
    print(str.splitn("a,b,c", ",", 0))
    print(len(str.splitn("a,b,c", ",", 0)))
    print(str.splitn("", ",", 0))
    print(str.splitn("abc", "", 0))
    print(str.join(str.splitn("a,b,c", ",", 1), "|"))
    print(str.join(str.splitn("", ",", 1), "--"))
    print(len(str.splitn("", ",", 1)))
    print(str.join(str.splitn(",", ",", 1), "|"))
