use std.str

fn main():
    print(str.splitn("a,b,", ",", 2))
    print(str.splitn("a,b,", ",", 3))
    print(str.join(str.splitn("a,b,", ",", 3), "|"))
    print(str.splitn(",", ",", 2))
    print(str.join(str.splitn(",", ",", 2), "|"))
    print(str.splitn(",,", ",", 3))
    print(str.join(str.splitn(",,", ",", 3), "|"))
    print(str.join(str.splitn("a,,b", ",", 2), "|"))
    print(str.join(str.splitn("a,,b", ",", 3), "|"))
