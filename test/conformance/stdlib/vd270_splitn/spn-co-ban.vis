use std.str

fn main():
    print(str.splitn("a,b,c", ",", 2))
    print(str.splitn("a,b,c", ",", 1))
    print(str.splitn("a,b,c", ",", 3))
    print(str.splitn("a,b,c", ",", 4))
    print(str.splitn("abc", ",", 2))
    print(str.splitn("a", ",", 99))
    print(str.splitn("a::b::c", "::", 2))
