fn main():
    let s: str = "a,b,c"
    print(s.splitn(",", 2))
    print("a,b,c".splitn(",", 1))
    let t: list[str] = s.splitn(",", 3)
    print(t)
    print("a,b,".splitn(",", 3).join("|"))
    print("abc".splitn("", 2))
    print("đ😀x😀".splitn("😀", 2))
