fn main():
    let xs: list[int] = [10, 20, 30, 20]
    print(xs.contains(20))
    print(xs.contains(99))
    print([1, 2, 1].contains(1))
    print(["a", "b"].contains("b"))
    print([[1], [2], [1]].contains([1]))
    print([[1], [2]].contains([3]))
    let b: bool = xs.contains(30)
    print(b)
