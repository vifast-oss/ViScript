use std.list

fn main():
    print(list.sum_float([-0.0]))
    print(list.sum_float([-0.0, -0.0]))
    print(list.sum_float([0.0, -0.0]))
    print(list.sum_float([-0.0, 0.0]))
    print(list.sum_float([-0.0, 0.0, -0.0]))
    print(1.0 / list.sum_float([-0.0]))
    print(1.0 / list.sum_float([-0.0, -0.0]))
