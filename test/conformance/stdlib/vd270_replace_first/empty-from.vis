use std.str

fn main():
    print(str.replace_first("abc", "", "-"))
    print(str.replace_first("", "", "-"))
    print(str.replace_first("abc", "", ""))
    print(str.replace_first("", "", ""))
    print(str.replace_first("đ", "", "😀"))
    print(str.replace_first("😀", "", "đ"))
