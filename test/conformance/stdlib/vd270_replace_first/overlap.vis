use std.str

fn main():
    print(str.replace_first("aaa", "aa", "b"))
    print(str.replace_first("aaaa", "aa", "b"))
    print(str.replace_first("aaa", "a", "aa"))
    print(str.replace_first("aaaa", "aaa", "b"))
    print(str.replace_first("abab", "aba", "X"))
