use std.str

fn main():
    print(str.replace_first("abc", "z", "X"))
    print(str.replace_first("abc", "abcd", "X"))
    print(str.replace_first("", "a", "b"))
    print(str.replace_first("đ😀x", "d", "D"))
    print(str.replace_first("abc", "ABC", "X"))
