use std.str

fn main():
    print(str.replace_first("", "a", "b"))
    print(str.replace_first("abc", "b", ""))
    print(str.replace_first("abc", "abc", ""))
    print(str.replace_first("banana", "na", ""))
    print(str.replace_first("a", "a", ""))
    print(str.replace_first("đ😀", "😀", ""))
