use std.list

fn main():
    let xs = [10, 20, 30, 40]
    print(list.binary_search(xs, 5))
    print(list.binary_search(xs, 45))
    print(list.binary_search(xs, 25))
    print(list.binary_search(xs, 35))
    let mot = [7]
    print(list.binary_search(mot, 6))
    print(list.binary_search(mot, 8))
