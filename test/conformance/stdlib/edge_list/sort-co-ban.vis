use std.list

fn main():
    print(list.sort([3, 1, 2, 1]))
    print(list.sort([]))
    print(list.sort([1]))
    print(list.sort([3.0, 1.0, 2.0]))
    print(list.sort([-0.0, 0.0, -1.0]))
    print(list.sort(["b", "a", "đ"]))
    print(list.sort([1, 3, 2]))
    print(list.sort([2, 2, 2]))
