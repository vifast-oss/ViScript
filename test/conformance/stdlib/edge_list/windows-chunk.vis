use std.list

fn main():
    print(list.windows([1, 2, 3, 4], 2))
    print(list.windows([1, 2], 3))
    print(list.windows([], 1))
    print(list.chunk([1, 2, 3, 4, 5], 2))
    print(list.chunk([1, 2, 3], 3))
    print(list.chunk([], 2))
    print(list.chunks_exact([1, 2, 3, 4, 5], 2))
    print(list.chunks_exact([1, 2, 3], 2))
