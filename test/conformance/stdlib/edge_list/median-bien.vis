use std.list

fn main():
    print(list.median([]))
    print(list.median([1.0]))
    print(list.median([1.0, 2.0]))
    print(list.median([3.0, 1.0, 2.0]))
    print(list.median([4.0, 1.0, 3.0, 2.0]))
    let nan = 0.0 / 0.0
    print(list.median([nan]))
    print(list.median([1.0, nan, 2.0]))
    print(list.median([1.0, 1.0 / 0.0]))
