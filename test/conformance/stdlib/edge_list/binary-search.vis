use std.list

fn main():
    print(list.binary_search([1, 3, 5], 3))
    print(list.binary_search([1, 3, 5], 2))
    print(list.binary_search([1, 1, 1], 1))
    print(list.binary_search([], 1))
    print(list.binary_search([2], 2))
    print(list.binary_search([1, 2, 2, 2, 3], 2))
    print(list.binary_search([2, 1, 3], 1))
    print(list.binary_search([2, 1, 3], 3))
    print(list.binary_search([2, 1, 3], 2))
    print(list.binary_search([1.0, 2.0, 3.0], 2.0))
