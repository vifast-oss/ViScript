use std.list

fn main():
    print(list.take([1, 2, 3], 0))
    print(list.take([1, 2, 3], 2))
    print(list.take([1, 2, 3], 9))
    print(list.take([1, 2, 3], -1))
    print(list.drop([1, 2, 3], 0))
    print(list.drop([1, 2, 3], 2))
    print(list.drop([1, 2, 3], 9))
    print(list.drop([1, 2, 3], -2))
