use std.str

fn main():
    print(str.strip_prefix("abc", ""))
    print(str.strip_suffix("abc", ""))
    print(str.strip_prefix("", ""))
    print(str.strip_suffix("", ""))
    print(str.strip_prefix("", "a"))
    print(str.strip_suffix("", "a"))
    print(str.strip_prefix(" ", ""))
    print(str.strip_suffix("đ😀", ""))
