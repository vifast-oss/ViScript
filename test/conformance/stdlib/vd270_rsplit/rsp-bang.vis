use std.str

fn main():
    print(str.rsplit("a,b,c", ","))
    print(str.rsplit("abc", ","))
    print(str.rsplit("abc", "abcd"))
    print(str.rsplit("a,b,", ","))
    print(str.rsplit(",a", ","))
    print(str.rsplit(",", ","))
    print(str.rsplit(",,", ","))
    print(str.rsplit("a,,b", ","))
    print(str.join(str.rsplit("a,b,", ","), "|"))
    print(str.join(str.rsplit("a,,b", ","), "|"))
    print(str.join(str.rsplit("a,b,c", ","), "|"))
