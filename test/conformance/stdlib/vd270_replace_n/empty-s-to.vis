use std.str

fn main():
    print(str.replace_n("", "a", "b", 1))
    print(str.replace_n("abc", "b", "", 1))
    print(str.replace_n("abc", "b", "", 2))
    print(str.replace_n("banana", "na", "", 2))
    print(str.replace_n("banana", "na", "", 1))
    print(str.replace_n("a", "a", "", 1))
    print(str.replace_n("đ😀", "😀", "", 5))
