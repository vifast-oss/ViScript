use std.str

fn main():
    print(str.is_blank("xin chào"))
    print(str.is_blank("đ"))
    print(str.is_blank("đ "))
    print(str.is_blank(" đ"))
    print(str.is_blank("😀"))
    print(str.is_blank(" \u{1F600} "))
    print(str.is_blank("👨‍👩‍👧"))
    print(str.is_blank("Σ"))
    print(str.is_blank("ß"))
