use std.list

fn main():
    let r: list[int] = []
    print(list.sum(r))
    print(list.product(r))
    print(list.sum([1, 2, 3]))
    print(list.product([1, 2, 3]))
    print(list.sum([-4, -6]))
    print(list.product([-4, -6]))
    print(list.sum([10, -3, 7]))
    print(list.product([10, -3, 7]))
    print(list.sum([5, 0, -5]))
    print(list.product([5, 0, -5]))
