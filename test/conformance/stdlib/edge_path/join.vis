use std.path

fn main():
    print(path.join("a/b", "c.txt"))
    print(path.join("a/b", "/abs"))
    print(path.join("/a", "/b"))
    print(path.join("", "x"))
    print(path.join("a", ""))
    print("[" + path.join("", "") + "]")
    print(path.join("a/", "b"))
    print(path.join("a//", "b"))
    print(path.join("a", "b//"))
    print(path.join_all(["a", "/b", "c"]))
