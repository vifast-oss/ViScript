use std.path

fn main():
    print("[" + path.basename("/") + "]")
    print("[" + path.basename("//") + "]")
    print("[" + path.basename("a/b/") + "]")
    print("[" + path.basename("") + "]")
    print(path.basename("a/b.txt"))
    print(path.basename("a/b.tar.gz"))
