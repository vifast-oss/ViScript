use std.list

fn main():
    let inf = 1.0 / 0.0
    print(list.min_float([inf, 1.0, 2.0]))
    print(list.max_float([inf, 1.0, 2.0]))
    print(list.min_float([1.0, -inf, 2.0]))
    print(list.max_float([1.0, -inf, 2.0]))
    print(list.min_float([inf, -inf]))
    print(list.max_float([inf, -inf]))
    print(list.min_float([inf, inf]))
    print(list.max_float([-inf, -inf]))
