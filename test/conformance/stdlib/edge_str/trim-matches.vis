use std.str

fn main():
    print("[" + str.trim_matches("xxabcxx", "x") + "]")
    print("[" + str.trim_start_matches("xxabcxx", "x") + "]")
    print("[" + str.trim_end_matches("xxabcxx", "x") + "]")
    print("[" + str.trim_matches("abab", "ab") + "]")
    print("[" + str.trim_matches("abc", "") + "]")
    print("[" + str.trim("\u{00a0} x \u{3000}") + "]")
    print("[" + str.trim_start("  x  ") + "]")
    print("[" + str.trim_end("  x  ") + "]")
