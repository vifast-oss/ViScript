use std.str

fn main():
    print(str.replace("abc", "", "-"))
    print("[" + str.replace("", "a", "b") + "]")
    print(str.replace("aaa", "aa", "b"))
    print(str.replace("đ😀", "😀", "X"))
    print(str.replace("abc", "z", "y"))
    print(str.replace_first("aaa", "a", "b"))
    print(str.replace_last("aaa", "a", "b"))
