use std.str

fn main():
    print(str.replace_last("abc", "", "-"))
    print(str.replace_last("", "", "-"))
    print(str.replace_last("abc", "", ""))
    print(str.replace_last("", "", ""))
    print(str.replace_last("đ", "", "😀"))
    print(str.replace_last("😀", "", "đ"))
