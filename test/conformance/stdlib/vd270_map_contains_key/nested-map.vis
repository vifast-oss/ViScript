use std.map

fn main():
    let m: map[map[str, int], str] = {({"a": 1, "b": 2}): "x", ({"c": 3}): "y"}
    print(map.contains_key(m, {"a": 1, "b": 2}))
    print(map.contains_key(m, {"b": 2, "a": 1}))
    print(map.contains_key(m, {"a": 1}))
    print(map.contains_key(m, {"a": 2, "b": 2}))
    print(map.contains_key(m, {}))
