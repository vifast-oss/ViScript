# SPDX-License-Identifier: MIT OR Apache-2.0
use std.json

type R:
    a: int
    b: str

enum E:
    A
    B(n: int)

fn main():
    print(json.encode({1: 2, 3: 4}))
    print(json.encode(R(a: 1, b: "x")))
    print(json.encode(E.A))
    print(json.encode(E.B(5)))
    print(json.encode((1, "a")))
    print(json.encode(Some(3)))
    let n: int? = None
    print(json.encode(n))
