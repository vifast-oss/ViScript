use std.json
use std.str

fn main():
    let n = 100
    let s = str.repeat("[", n) + str.repeat("]", n)
    match json.decode(s):
        Ok(v):
            let t = json.encode(v)
            print(str.byte_len(t))
            print(t == s)
        Err(e):
            print(e.message)
    let d = str.repeat("{{\"a\":", n) + "1" + str.repeat("}", n)
    match json.decode(d):
        Ok(v):
            let t = json.encode(v)
            print(str.byte_len(t))
            print(t == d)
        Err(e):
            print(e.message)
