use std.str

fn main():
    match str.rsplit_once("a,b,c", ","):
        Some(xs):
            print(len(xs))
            print(str.join(xs, "|"))
        None:
            print("none")
    match str.rsplit_once("a,b,c", "x"):
        Some(_): print("some")
        None: print("none")
    let a: list[str]? = str.rsplit_once("a,b", ",")
    let b: list[str]? = str.rsplit_once("a,b", "x")
    print(a)
    print(b)
    match str.rsplit_once("abc", ""):
        Some(xs): print(len(xs))
        None: print(-1)
    match str.rsplit_once(",", ","):
        Some(xs): print(len(xs))
        None: print(-1)
