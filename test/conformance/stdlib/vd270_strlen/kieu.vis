use std.str
use std.list
use std.map

fn main():
    let b: int = str.byte_len("đ")
    let c: int = str.char_count("đ")
    let e: bool = str.is_empty("")
    let le: bool = list.is_empty([])
    let me: bool = map.is_empty({})
    print(b)
    print(c)
    print(e)
    print(le)
    print(me)
