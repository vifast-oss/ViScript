use std.list

fn main():
    let nan = 0.0 / 0.0
    let inf = 1.0 / 0.0
    print(list.mean([nan, 1.0]))
    print(list.mean([1.0, nan]))
    print(list.mean([inf, 1.0]))
    print(list.mean([-inf, 1.0]))
    print(list.mean([inf, -inf]))
    print(list.mean([nan, inf]))
