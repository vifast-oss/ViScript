use std.list

fn main():
    var xs: list[int] = [1, 2, 3, 4, 5]
    let g: list[list[int]] = list.chunks_exact(xs, 2)
    xs[0] = 9
    xs[4] = 8
    print(g)
    print(xs)
    var ys: list[list[int]] = [[1, 2], [3, 4], [5]]
    let h = list.chunks_exact(ys, 2)
    ys[0][0] = 99
    print(h)
