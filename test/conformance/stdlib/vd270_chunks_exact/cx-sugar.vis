fn main():
    let xs: list[int] = [1, 2, 3, 4, 5]
    print(xs.chunks_exact(2))
    let g: list[list[int]] = xs.chunks_exact(2)
    print(g[0])
    print(g.len())
    print([10, 20, 30].chunks_exact(3))
    print(["a", "b", "c", "d"].chunks_exact(3))
    let n: int = 3
    print(xs.chunks_exact(n))
