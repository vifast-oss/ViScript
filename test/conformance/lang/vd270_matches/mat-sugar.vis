fn main():
    let s: str = "banana"
    print(s.matches("ana"))
    print("aaaa".matches("aa"))
    let t: list[str] = s.matches("ana")
    print(t)
    print(t.len())
    print(t[0])
    for m in "a😀b😀c".matches("😀"):
        print(m)
    print("abc".matches(""))
    print(len("abc".matches("")))
    print("".matches(""))
    print(len("".matches("")))
