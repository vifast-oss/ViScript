use std.str

fn main():
    print(str.find("banana", "ana"))
    print(str.rfind("banana", "ana"))
    print(str.count("banana", "ana"))
    print(str.split("banana", "ana"))
    print(str.matches("banana", "ana"))
    print(str.count("aaaa", "aa"))
    print(str.matches("aaaa", "aa"))
