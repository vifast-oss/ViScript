use std.str

fn main():
    let a = str.lines("")
    let b = str.lines("\n")
    print(a)
    print(a.len())
    print(b)
    print(b.len())
    print(str.lines("a"))
    print(str.lines("a\n"))
    print(str.lines("a\r\nb"))
    print(str.lines("a\r\nb\n"))
    print(str.lines("a\n\n"))
