fn main():
    let xs = [1]
    let m = {"a": 1}
    let a = if false: xs.get(0) else: 2
    let b = if false: xs.first() else: 3
    let c = if false: m.get("a") else: 4
    let d = if false: first(xs) else: 5
    print(a)
    print(b)
    print(c)
    print(d)
    match a:
        Some(v): print(v)
        None: print("none")
