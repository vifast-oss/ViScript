# SPDX-License-Identifier: MIT OR Apache-2.0
fn f() -> int?:
    Some(1)

fn g(flag: bool) -> int?:
    if flag:
        f()
    else:
        2

fn h() -> int?:
    match 2:
        1: f()
        _: 3

fn main():
    print(g(false))
    print(g(true))
    print(h())
    match g(false):
        Some(v): print(v)
        None: print("none")
