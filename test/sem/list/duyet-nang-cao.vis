# **R20b (VD-178)**: `enumerate`/`any`/`all`/`find`.
fn lon(x: int) -> bool:
    x > 25

fn duong(x: int) -> bool:
    x > 5

fn qua(x: int) -> bool:
    x > 15

fn main():
    let xs = [10, 20, 30]
    print(xs.enumerate())
    print(xs.any(lon))
    print(xs.all(duong))
    print(xs.find(qua))
    print(xs.find(lon))
