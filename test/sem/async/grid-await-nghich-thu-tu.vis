# VD-240 (b) grid / VS3-1d: scheduler frame chạy task theo **thứ tự spawn/ready**; `await`
# ngược thứ tự spawn không làm đổi thứ tự đã chạy. Đây là chủ đích của scheduler mới.
async fn in_so(n: int) -> int:
    print("task {n}")
    n

fn main() -> ():
    let a = spawn in_so(1)
    let b = spawn in_so(2)
    print("main")
    print(await b)
    print(await a)
