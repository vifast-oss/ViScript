# VD-241 §7 + đợt coercion Option (A0, 2026-11-19) — thân hàm `-> int??` bằng `None` trần: hợp lệ
# (thân cuối là `None`; lớp ngoài cùng của `want` là `Option`). Bảng giá trị A0 cho `None` ở biên
# **return** là **giữ nguyên** ⇒ `h()` lúc gọi bằng `None` ⇒ khớp arm `None`.
# (Hành vi trước ở 3b2c67e nâng `None` thành `Some(None)` — sai theo ngữ nghĩa chốt.)
fn h() -> int??:
    None

fn main():
    match h():
        None: print("none-out")
        Some(None): print("sn")
        Some(Some(v)): print("two {v}")
