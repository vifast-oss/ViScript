# VD-241 §3+ (A0, 2026-11-19) — `first(rong)` trả `None` (biên return `T?` giữ nguyên `None`);
# `let y: int?? = None` giữ nguyên `None` lớp ngoài theo bảng giá trị A0 (trước ở 3b2c67e thành `Some(None)` — sai).
fn first[T](xs: list[T]) -> T?:
    if xs.is_empty():
        return None
    return xs[0]

fn main():
    let xs: list[int?] = [Some(42)]
    let x: int?? = first(xs)
    print(x)
    let rong: list[int?] = []
    let y: int?? = first(rong)
    print(y)
