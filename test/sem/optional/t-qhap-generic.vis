fn first[T](xs: list[T]) -> T?:
    if xs.is_empty():
        return None
    return xs[0]

fn main():
    let xs: list[int?] = [Some(42)]
    let x: int?? = first(xs)
    print(x)
    let rong: list[int?] = []
    let y: int?? = first(rong)
    print(y)
