# VD-178 R2 (sửa theo VD-241/A0 2026-11-19): `int??` là `Option[Option[int]]` thật
# (không làm phẳng). `let` gán giá trị lồng trực tiếp; `??` bóc **một** lớp.
fn main():
    let x: int?? = Some(Some(5))
    let y: int?? = Some(None)
    let z: int?? = Some(Some(7))
    print(x ?? 0)
    print(y ?? 100)
    print(z)
