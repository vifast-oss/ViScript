use std.sqlite

fn main():
    match sqlite.open(":memory:"):
        Err(e): print("loi {e.message}")
        Ok(h):
            let _ = sqlite.execute(h, "CREATE TABLE t (a TEXT)", [])
            let _ = sqlite.execute(h, "INSERT INTO t VALUES (?)", [SqlValue.Text("o'clock")])
            match sqlite.query(h, "SELECT a FROM t", []):
                Err(e): print("loi query {e.message}")
                Ok(rs):
                    for row in rs.rows:
                        for cell in row:
                            match cell:
                                Text(s): print(s)
                                Null: print("null")
                                Integer(n): print("int")
                                Real(f): print("real")
                                Blob(b): print("blob")
            let _ = sqlite.close(h)
