use std.sqlite

# SAVEPOINT / RELEASE — được phép (đã duyệt trong hợp đồng MVP — không tự mở rộng).
fn main():
    match sqlite.open(":memory:"):
        Err(e): print("loi {e.message}")
        Ok(h):
            let _ = sqlite.execute(h, "CREATE TABLE t (a INTEGER)", [])
            let _ = sqlite.execute(h, "SAVEPOINT sp1", [])
            let _ = sqlite.execute(h, "INSERT INTO t VALUES (1)", [])
            let _ = sqlite.execute(h, "RELEASE sp1", [])
            match sqlite.query(h, "SELECT count(*) FROM t", []):
                Err(e): print("loi query {e.message}")
                Ok(rs):
                    for row in rs.rows:
                        for cell in row:
                            print(cell)
            let _ = sqlite.close(h)
