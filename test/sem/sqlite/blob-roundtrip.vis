use std.sqlite

fn main():
    match sqlite.open(":memory:"):
        Err(e): print("loi {e.message}")
        Ok(h):
            let _ = sqlite.execute(h, "CREATE TABLE t (a BLOB)", [])
            let _ = sqlite.execute(h, "INSERT INTO t VALUES (?)", [SqlValue.Blob(b"")])
            let _ = sqlite.execute(h, "INSERT INTO t VALUES (?)", [SqlValue.Blob(b"\x00\x01\x02\xfe")])
            match sqlite.query(h, "SELECT a FROM t", []):
                Err(e): print("loi query {e.message}")
                Ok(rs):
                    for row in rs.rows:
                        for cell in row:
                            match cell:
                                Blob(b): print("blob({len(b)})")
                                Null: print("null")
                                Integer(n): print("int")
                                Real(f): print("real")
                                Text(s): print("text")
            let _ = sqlite.close(h)
