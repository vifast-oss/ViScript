use std.sqlite

fn main():
    match sqlite.open(":memory:"):
        Err(e): print("loi {e.message}")
        Ok(h):
            match sqlite.query(h, "WITH RECURSIVE c(x) AS (SELECT 1 UNION ALL SELECT x + 1 FROM c WHERE x < 10001) SELECT x FROM c", []):
                Ok(_): print("KHONG DUOC PHU")
                Err(e): print("vuot gioi han hang")
            let _ = sqlite.close(h)
