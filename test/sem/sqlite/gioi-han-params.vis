use std.sqlite

fn main():
    match sqlite.open(":memory:"):
        Err(e): print("loi {e.message}")
        Ok(h):
            var params: list[SqlValue] = []
            var i = 0
            while i < 1001:
                params.push(SqlValue.Integer(i))
                i = i + 1
            match sqlite.execute(h, "SELECT 1", params):
                Ok(_): print("khong duoc phu")
                Err(e): print("chan {e.message}")
            let _ = sqlite.close(h)
