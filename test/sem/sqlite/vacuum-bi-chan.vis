use std.sqlite

# `VACUUM` trơn — luôn bị chặn.
fn main():
    match sqlite.open(":memory:"):
        Err(e): print("loi {e.message}")
        Ok(h):
            let _ = sqlite.execute(h, "CREATE TABLE t (a INTEGER)", [])
            match sqlite.execute(h, "VACUUM", []):
                Ok(_): print("vacuum: KHONG DUOC PHU")
                Err(e): print("vacuum bi chan")
            let _ = sqlite.close(h)
