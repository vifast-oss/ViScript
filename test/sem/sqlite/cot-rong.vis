use std.sqlite

fn main():
    match sqlite.open(":memory:"):
        Err(e): print("loi {e.message}")
        Ok(h):
            let _ = sqlite.execute(h, "CREATE TABLE t (a INTEGER, b TEXT)", [])
            match sqlite.query(h, "SELECT a, b FROM t", []):
                Err(e): print("loi query {e.message}")
                Ok(rs):
                    print("cols={rs.columns}")
                    print("so dong={rs.rows.len()}")
            let _ = sqlite.close(h)
