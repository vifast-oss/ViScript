# **R7 (VD-178)**: `/` luôn `float`; `//` chia lấy phần nguyên (làm tròn xuống); `%` khớp `//`.
fn main():
    print(7 / 2)
    print(7 // 2)
    print(-7 // 2)
    print(7 % 2)
    print(-7 % 2)
    print(5mb / 5mb)
    var x = 7
    x //= 2
    print(x)
    # **R7-fix (ST-197)**: số chia **âm** — `//` vẫn làm tròn xuống, `%` cùng dấu số chia.
    print(7 // -2)
    print(-7 // -2)
    print(7 % -2)
    print(-7 % -2)
