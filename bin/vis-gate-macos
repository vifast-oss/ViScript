#!/usr/bin/env python3
# SPDX-License-Identifier: MIT OR Apache-2.0
"""**ST-300m1 (VD-284 §2)** — cổng macOS thật (`mps`) qua `bin/vis-remote`.

Chạy trên máy Linux/`ps`, ssh sang **macOS arm64 `mps`**; mọi job nặng được bọc trong
`bin/vis-lock` để không tranh máy với W4/soak. Không merge/push/tag, không tự đồng bộ mã:
cây trên `mps` phải **sạch** và **cùng HEAD** với cây gọi (nếu lệch ⇒ exit 4, in gợi ý).

    bin/vis-gate-macos --quick [--dry-run]
    bin/vis-gate-macos --full  [--dry-run]
    bin/vis-gate-macos --self-test

`--quick`: `cargo check --workspace` + `quyen_st174`/`quyen_st295` (unit, đòi >0 test) +
           `vis-conformance/lib_api_it lat` (mio/kqueue thật, `--no-tests=fail`).
           `--full`: thêm `./vis-dev check`, `./vis-dev gate --fast`,
           `cargo nextest run --workspace`, `cargo test --doc`, host native
           `vis-host-wasm`, và `bin/vis-wasm-suite --build --runtime node` (WASI tối thiểu).

Log mặc định `~/vislogs/vis-gate-macos-<mode>-<UTC>.log` (ngoài repo); đổi bằng
`VIS_GATE_MACOS_LOG`. Biến môi trường: `VIS_GATE_MACOS_REMOTE` (mặc định `mps`),
`VIS_GATE_MACOS_TARGET` (mặc định `target/gate-macos`), `VIS_GATE_MACOS_LOCK_TIMEOUT`
(mặc định 7200 giây). Python 3.9+.
"""

import argparse
import datetime
import os
import shlex
import subprocess
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
REMOTE = os.environ.get("VIS_GATE_MACOS_REMOTE", "mps")
TARGET = os.environ.get("VIS_GATE_MACOS_TARGET", "target/gate-macos")
LOCK_TIMEOUT = int(os.environ.get("VIS_GATE_MACOS_LOCK_TIMEOUT", "7200"))
REPO = os.environ.get("VIS_GATE_MACOS_REPO", "/Users/mps/dvchd/ViScript")


def log_path(mode):
    raw = os.environ.get("VIS_GATE_MACOS_LOG")
    if raw:
        p = Path(raw).expanduser().resolve()
    else:
        stamp = datetime.datetime.now(datetime.timezone.utc).strftime("%Y%m%dT%H%M%SZ")
        p = (Path.home() / "vislogs" / f"vis-gate-macos-{mode}-{stamp}.log").resolve()
    try:
        p.relative_to(ROOT)
    except ValueError:
        return p
    sys.exit(f"vis-gate-macos: log nằm TRONG repo ({p}); chọn VIS_GATE_MACOS_LOG ngoài repo")


def head():
    out = subprocess.run(
        ["git", "-C", str(ROOT), "rev-parse", "HEAD"],
        check=True,
        stdout=subprocess.PIPE,
        text=True,
    )
    return out.stdout.strip()


def dem_test(cmd):
    """**ST-314a (hậu-kiểm low-peak)**: libtest trả exit 0 khi filter không khớp ca nào (0 test) — phải đòi
    `test result: ok. N passed` với N ≥ 1, nếu không cổng xanh mà không chạy gì."""
    return (
        'out="$(%s 2>&1)" && printf "%%s\\n" "$out" '
        '&& printf "%%s\\n" "$out" | grep -Eq "test result: ok\\. [1-9][0-9]* passed" '
        '|| { rc=$?; printf "%%s\\n" "$out" >&2; exit "$rc"; }' % cmd
    )


def commands(mode):
    if mode == "quick":
        return [
            "cargo check --workspace",
            dem_test("cargo test -p vis-host-native --lib quyen_st"),
            # **ST-314a (hậu-kiểm low-peak)**: test `lat*` đã chuyển sang `vis-conformance/tests/lib_api_it.rs`;
            # filter cũ `-p vis-cli --test async_it lat` khớp 0 ca. `--no-tests=fail`
            # biến "0 ca" thành đỏ trên mọi bản nextest hỗ trợ cờ này (mps: 0.9.152).
            "cargo nextest run -p vis-conformance --test lib_api_it --no-tests=fail lat",
        ]
    return [
        "./vis-dev check",
        "./vis-dev gate --fast",
        # **ST-300m3**: dùng nextest (chuẩn L0 của repo) thay libtest cho workspace.
        # Trên macOS, `lat256_net::t3` đỏ tất định dưới libtest nhưng xanh dưới nextest
        # (mỗi ca một process); đây là khác biệt harness, không phải sản phẩm.
        # Doc-test vẫn chạy riêng vì nextest không chạy doc-test.
        "cargo nextest run --workspace",
        "cargo test --doc",
        "cargo test --manifest-path vis-host-wasm/Cargo.toml",
        "bin/vis-wasm-suite --build --runtime node",
    ]


def body(mode):
    inner = "\n".join(
        [
            "set -euo pipefail",
            "cd %s" % shlex.quote(REPO),
            'export PATH="$HOME/.cargo/bin:$PATH"',
            "export CARGO_BUILD_JOBS=3 CARGO_PROFILE_DEV_DEBUG=0",
            'export TMPDIR="${TMPDIR:-$HOME/tmp}"',
            'mkdir -p "$TMPDIR"',
            "export CARGO_TARGET_DIR=%s" % shlex.quote(str(Path(REPO) / TARGET)),
        ]
        + commands(mode)
    )
    return "\n".join(
        [
            "set -euo pipefail",
            "cd %s" % shlex.quote(REPO),
            'test "$(git rev-parse HEAD)" = "%s" || { echo "vis-gate-macos: HEAD mps khác %s — đồng bộ nhánh rồi chạy lại" >&2; exit 4; }'
            % (head(), head()[:12]),
            "bin/vis-lock --timeout %d --log \"$HOME/vislogs/vis-lock-gate-macos.log\" -- bash -c %s"
            % (LOCK_TIMEOUT, shlex.quote(inner)),
        ]
    )


def remote_cmd(mode, log):
    return [
        str(ROOT / "bin" / "vis-remote"),
        REMOTE,
        "--require-clean",
        "--log",
        str(log),
        "--",
        "bash",
        "-lc",
        body(mode),
    ]


def self_test():
    quick, full = body("quick"), body("full")
    checks = [
        ("quick: quyền", "quyen_st" in quick),
        ("quick: quyền >0 test", "test result: ok" in quick),
        ("quick: lat/kqueue", "lib_api_it" in quick and " lat" in quick),
        ("quick: lat 0-test", "--no-tests=fail" in quick),
        ("full: check", "./vis-dev check" in full),
        ("full: gate", "./vis-dev gate --fast" in full),
        ("full: workspace", "cargo nextest run --workspace" in full),
        ("full: doc-test", "cargo test --doc" in full),
        ("full: host", "vis-host-wasm" in full),
        ("full: wasm", "vis-wasm-suite --build --runtime node" in full),
        ("lock", "bin/vis-lock" in quick and "bin/vis-lock" in full),
        ("HEAD guard", 'git rev-parse HEAD' in quick),
        ("no test-child", "test-child" not in quick and "test-child" not in full),
    ]
    bad = [name for name, ok in checks if not ok]
    if bad:
        sys.exit("vis-gate-macos: self-test FAIL: " + ", ".join(bad))
    for mode in ("quick", "full"):
        p = log_path(mode)
        try:
            p.relative_to(ROOT)
            sys.exit("vis-gate-macos: self-test FAIL: log trong repo")
        except ValueError:
            pass
    print("vis-gate-macos: self-test OK (%d kiểm, Python %d.%d)" % (len(checks), sys.version_info[0], sys.version_info[1]))


def main():
    ap = argparse.ArgumentParser(add_help=True)
    ap.add_argument("--quick", action="store_true")
    ap.add_argument("--full", action="store_true")
    ap.add_argument("--dry-run", action="store_true")
    ap.add_argument("--self-test", action="store_true")
    a = ap.parse_args()
    if a.self_test:
        self_test()
        return 0
    if a.quick == a.full:
        ap.error("cần đúng một trong --quick/--full")
    mode = "quick" if a.quick else "full"
    log = log_path(mode)
    cmd = remote_cmd(mode, log)
    if a.dry_run:
        print(shlex.join(cmd))
        return 0
    log.parent.mkdir(parents=True, exist_ok=True)
    print("vis-gate-macos: mode=%s remote=%s log=%s" % (mode, REMOTE, log), file=sys.stderr)
    return subprocess.call(cmd)


if __name__ == "__main__":
    sys.exit(main())
