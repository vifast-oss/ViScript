#!/usr/bin/env python3
# SPDX-License-Identifier: MIT OR Apache-2.0
"""**ST-313c (VD-289)** — chạy corpus `test/conformance/**` trên WASI (`wasm32-wasip1`).

Mỗi ca `.vis` (có `.out`/`.out_prefix` **hoặc** `.trap`) chạy **cả interp và VM**
qua `vis-wasm-run.wasm` (runtime `node:wasi`), so stdout và rc=0. Bỏ qua:
- ca dùng host fs/net/sqlite/proc (giống `vis-wasm-sem`) và ca lỗi tĩnh (`.err`);
- ca lỗi **lúc chạy** (`.trap`) được assert riêng: exit ≠ 0, stdout khớp `.out` (nếu có) và stderr
  chứa **đủ từng mã** trong `.trap`;
- ca `lang/async/` + `lang/kenh/` (chưa có backend scheduler trên WASI, như `vis-wasm-sem`).
Corpus rỗng ⇒ FAIL (không coi 0 ca là PASS).

Cùng cấu hình stack với `vis-wasm-suite`: `-zstack-size=12 MiB` + `node --stack-size=4096`
(env `VIS_WASM_STACK_MB`/`VIS_WASM_NODE_STACK_KB`).
"""

import json
import os
import shutil
import subprocess
import sys
import tempfile
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
WS = ROOT / "vis-host-wasm"
TARGET = Path(os.environ.get("CARGO_TARGET_DIR") or (WS / "target"))
if not TARGET.is_absolute():
    TARGET = ROOT / TARGET
WASM = TARGET / "wasm32-wasip1/release/vis-wasm-run.wasm"
CORPUS = ROOT / "test/conformance"
WASM_STACK_MB = int(os.environ.get("VIS_WASM_STACK_MB", "12"))
NODE_STACK_KB = int(os.environ.get("VIS_WASM_NODE_STACK_KB", "4096"))
BO_QUA = ("use std.fs", "use std.net", "use std.sqlite", "use std.proc", "use pkg.", "use ./")

NODE_DRIVER = r"""
import { WASI } from 'node:wasi';
import { readFile } from 'node:fs/promises';
const [wasmPath, guest, host, ...args] = process.argv.slice(2);
if (process.env.VIS_WASM_TRACE_ARGV === '1') console.error('ARGV=' + JSON.stringify(args));
const env = { VIS_WASM_PREOPENS: guest };
if (process.env.VIS_WASM_TRACE_ENGINE === '1') env.VIS_WASM_TRACE_ENGINE = '1';
const wasi = new WASI({
  version: 'preview1',
  args: ['vis-wasm-run', ...args],
  env,
  preopens: { [guest]: host },
});
const wasm = await WebAssembly.compile(await readFile(wasmPath));
const instance = await WebAssembly.instantiate(wasm, wasi.getImportObject());
const code = wasi.start(instance);
process.exit(code);
"""


def cargo() -> str:
    p = Path.home() / ".cargo/bin/cargo"
    return str(p) if p.is_file() else (shutil.which("cargo") or "cargo")


def build() -> None:
    env = os.environ.copy()
    env["PATH"] = f"{Path.home() / '.cargo/bin'}{os.pathsep}{env.get('PATH', '')}"
    env.setdefault("CARGO_BUILD_JOBS", "3")
    env.setdefault("CARGO_PROFILE_DEV_DEBUG", "0")
    stack = f"-C link-arg=-zstack-size={WASM_STACK_MB * 1024 * 1024}"
    env["RUSTFLAGS"] = (env.get("RUSTFLAGS", "") + " " + stack).strip()
    cmd = [cargo(), "build", "--release", "--target", "wasm32-wasip1",
           "--manifest-path", str(WS / "Cargo.toml")]
    print("# build:", " ".join(cmd), file=sys.stderr)
    try:
        r = subprocess.run(cmd, cwd=ROOT, env=env)
    except OSError as e:
        print(f"BLOCKED-ENV: không chạy được cargo: {e}", file=sys.stderr)
        sys.exit(2)
    if r.returncode != 0 or not WASM.is_file():
        print("BLOCKED-ENV: build wasm32-wasip1 lỗi/không thấy wasm", file=sys.stderr)
        sys.exit(2)


def chay(
    driver: Path, root: Path, *runner_args: str, env: dict[str, str] | None = None
) -> subprocess.CompletedProcess:
    node = shutil.which("node")
    if not node:
        print("BLOCKED-ENV: không có node:wasi", file=sys.stderr)
        sys.exit(2)
    cmd = [node, "--no-warnings", f"--stack-size={NODE_STACK_KB}", str(driver),
           str(WASM), "/data", str(root), *runner_args]
    e = os.environ.copy()
    for k in ("VIS_WASM_TRACE_ARGV", "VIS_WASM_TRACE_ENGINE"):
        e.pop(k, None)
    if env:
        e.update(env)
    return subprocess.run(
        cmd, capture_output=True, text=True, encoding="utf-8", errors="replace",
        timeout=120, env=e,
    )


def kiem_node() -> None:
    """**ST-314a**: phân biệt 'node thiếu node:wasi' (BLOCKED-ENV) với lỗi harness."""
    node = shutil.which("node")
    if not node:
        print("BLOCKED-ENV: không có node:wasi", file=sys.stderr)
        sys.exit(2)
    r = subprocess.run(
        [node, "-e", "const {WASI}=require('node:wasi'); new WASI({version:'preview1'});"],
        capture_output=True,
        text=True,
        encoding="utf-8",
        errors="replace",
    )
    if r.returncode != 0:
        print(
            "BLOCKED-ENV: node không có module `node:wasi` "
            f"({r.stderr.strip()[:120]})",
            file=sys.stderr,
        )
        sys.exit(2)


def tu_kiem(driver: Path, root: Path) -> None:
    """**ST-314a (VD-290)**: chứng minh argv và engine **không bị nuốt**.

    - Cờ lạ phải tới `vis-wasm-run`, bị từ chối `[USAGE-UNKNOWN]` + exit 2 **trước khi chạy**.
    - `--interp`/`--vm` phải tới runner **nguyên vị trí** (trace ARGV) và chọn đúng
      `Engine::Interp`/`Engine::Vm` (trace engine, env-gated).
    - Chương trình hợp lệ in `SELF-CHECK-LEAK`: nếu cờ bị nuốt (lỗi `ro` cũ), chương trình chạy
      và self-check fail ngay. Thư mục rỗng không đủ vì lỗi "thiếu tệp" cũng trả exit 2.
    """
    root.mkdir()
    (root / "prog.vis").write_text(
        'fn main():\n    print("SELF-CHECK-LEAK")\n', encoding="utf-8"
    )
    trace = {"VIS_WASM_TRACE_ARGV": "1", "VIS_WASM_TRACE_ENGINE": "1"}
    r = chay(driver, root, "--co-khong-ton-tai", "/data/prog.vis", env=trace)
    argv_la = "ARGV=" + json.dumps(
        ["--co-khong-ton-tai", "/data/prog.vis"],
        separators=(",", ":"),
        ensure_ascii=False,
    )
    if (
        r.returncode != 2
        or "SELF-CHECK-LEAK" in r.stdout
        or "[USAGE-UNKNOWN]" not in r.stderr
        or argv_la not in r.stderr
    ):
        print(
            f"SELF-CHECK: cờ lạ không tới `vis-wasm-run` hoặc bị nuốt (rc={r.returncode}, "
            f"stdout={r.stdout[:120]!r}, stderr={r.stderr[:200]!r})",
            file=sys.stderr,
        )
        sys.exit(1)
    # Cờ engine phải tới runner đúng vị trí và chọn đúng engine.
    for engine, ten in (("interp", "Interp"), ("vm", "Vm")):
        p = chay(driver, root, f"--{engine}", "/data/prog.vis", env=trace)
        argv = "ARGV=" + json.dumps(
            [f"--{engine}", "/data/prog.vis"],
            separators=(",", ":"),
            ensure_ascii=False,
        )
        if (
            p.returncode != 0
            or "SELF-CHECK-LEAK" not in p.stdout
            or argv not in p.stderr
            or f"engine={ten}" not in p.stderr
        ):
            print(
                f"SELF-CHECK: `--{engine}` không tới runner/không chọn `{ten}` "
                f"(rc={p.returncode}, stdout={p.stdout[:120]!r}, stderr={p.stderr[:200]!r})",
                file=sys.stderr,
            )
            sys.exit(1)
    # Token sau `--` phải tới runner nguyên văn và **không** đổi engine.
    tail_args = ["--interp", "/data/prog.vis", "--", "--vm", "arg1"]
    p = chay(driver, root, *tail_args, env=trace)
    argv = "ARGV=" + json.dumps(
        tail_args, separators=(",", ":"), ensure_ascii=False
    )
    if (
        p.returncode != 0
        or "SELF-CHECK-LEAK" not in p.stdout
        or argv not in p.stderr
        or "engine=Interp" not in p.stderr
    ):
        print(
            f"SELF-CHECK: token sau `--` không tới runner/đổi engine "
            f"(rc={p.returncode}, stdout={p.stdout[:120]!r}, stderr={p.stderr[:200]!r})",
            file=sys.stderr,
        )
        sys.exit(1)


def main() -> int:
    import argparse

    ap = argparse.ArgumentParser(
        description="Chạy corpus conformance trên WASI (interp + VM)"
    )
    try:
        ap.parse_args()
    except SystemExit as e:
        # `--help` vẫn 0; cờ lạ của harness là lỗi sử dụng (1), không phải BLOCKED-ENV (2).
        return 0 if e.code == 0 else 1
    kiem_node()
    build()
    cases = []
    cases_trap = []
    bo_qua = 0
    so_err = 0
    so_trap = 0
    so_async = 0
    for p in sorted(CORPUS.rglob("*.vis")):
        # **ST-314a (hậu-kiểm low-peak)**: `.trap` = lỗi lúc chạy (file chứa mã chẩn đoán);
        # cần assertion trap riêng, chưa chạy như ca `.out`/rc=0 được.
        if p.with_suffix(".trap").exists():
            # **ST-314a (hậu-kiểm low-peak)**: ca trap chạy được trên WASI (không cần host) —
            # assert riêng ở vòng dưới (exit ≠ 0 + stdout + mã trong stderr), không trộn ca `.out`.
            so_trap += 1
            rel_t = p.relative_to(CORPUS)
            if len(rel_t.parts) >= 2 and rel_t.parts[0] == "lang" and rel_t.parts[1] in (
                "async",
                "kenh",
            ):
                so_async += 1
                continue
            src_t = p.read_text(encoding="utf-8")
            if any(x in src_t for x in BO_QUA):
                bo_qua += 1
                continue
            # Đệ quy sâu: ngưỡng stack WASI khác native — không so mã trap ở đây.
            if "de-quy-qua-sau" in p.name:
                continue
            cases_trap.append(p)
            continue
        if p.with_suffix(".err").exists():
            so_err += 1
            continue
        rel = p.relative_to(CORPUS)
        # Cùng lý do `vis-wasm-sem`: WASI chưa có backend scheduler cho async/kenh.
        if len(rel.parts) >= 2 and rel.parts[0] == "lang" and rel.parts[1] in (
            "async",
            "kenh",
        ):
            so_async += 1
            continue
        if not p.with_suffix(".out").exists() and not p.with_suffix(".out_prefix").exists():
            continue
        src = p.read_text(encoding="utf-8")
        if any(x in src for x in BO_QUA):
            bo_qua += 1
            continue
        cases.append(p)
    print(
        f"# {len(cases)} ca hợp lệ trên WASI "
        f"(bỏ qua {bo_qua} ca host/đa tệp + {so_async} ca async/kenh chưa chạy WASI "
        f"+ {so_err} ca lỗi tĩnh; {len(cases_trap)}/{so_trap} ca trap assert riêng)",
        file=sys.stderr,
    )
    # **ST-314a (hậu-kiểm low-peak)**: corpus rỗng (hoặc bị bộ lọc loại hết) không được coi là PASS —
    # trước đây in `0 ca` rồi `return 0`, tức cổng xanh mà không chạy gì.
    if not cases and not cases_trap:
        print(
            "KHÔNG có ca conformance hợp lệ nào — tính là FAIL, không phải PASS",
            file=sys.stderr,
        )
        return 1
    work = Path(tempfile.mkdtemp(prefix="vis-wasm-conformance-"))
    hong = []
    try:
        driver = work / "node-driver.mjs"
        driver.write_text(NODE_DRIVER, encoding="utf-8")
        tu_kiem(driver, work / "self-check")
        for i, p in enumerate(cases, 1):
            root = work / f"c{i}"
            root.mkdir()
            shutil.copyfile(p, root / "prog.vis")
            khop = lambda s: s.startswith(
                p.with_suffix(".out_prefix").read_text(encoding="utf-8")
            ) if p.with_suffix(".out_prefix").exists() else s == p.with_suffix(".out").read_text(
                encoding="utf-8"
            )
            for engine in ("interp", "vm"):
                try:
                    r = chay(driver, root, f"--{engine}", "/data/prog.vis")
                except subprocess.TimeoutExpired:
                    hong.append(f"{p.relative_to(ROOT)} [{engine}] timeout > 120s")
                    continue
                if r.returncode != 0 or not khop(r.stdout):
                    hong.append(f"{p.relative_to(ROOT)} [{engine}] rc={r.returncode} "
                                f"stdout={r.stdout!r} stderr={r.stderr[:120]!r}")
        # **ST-314a (hậu-kiểm low-peak)**: ca `.trap` — exit ≠ 0, stdout khớp, đủ mã trong stderr.
        for j, p in enumerate(cases_trap, 1):
            root = work / f"t{j}"
            root.mkdir()
            shutil.copyfile(p, root / "prog.vis")
            mong = [
                x.strip()
                for x in p.with_suffix(".trap").read_text(encoding="utf-8").splitlines()
                if x.strip()
            ]
            out_p = p.with_suffix(".out")
            out_mong = out_p.read_text(encoding="utf-8") if out_p.exists() else ""
            for engine in ("interp", "vm"):
                try:
                    r = chay(driver, root, f"--{engine}", "/data/prog.vis")
                except subprocess.TimeoutExpired:
                    hong.append(f"{p.relative_to(ROOT)} [{engine}] trap timeout > 120s")
                    continue
                if r.returncode == 0:
                    hong.append(
                        f"{p.relative_to(ROOT)} [{engine}] trap nhưng rc=0 "
                        f"stdout={r.stdout!r}"
                    )
                elif r.stdout != out_mong:
                    hong.append(
                        f"{p.relative_to(ROOT)} [{engine}] trap stdout={r.stdout!r} "
                        f"chờ {out_mong!r}"
                    )
                for ma in mong:
                    if ma not in r.stderr:
                        hong.append(
                            f"{p.relative_to(ROOT)} [{engine}] thiếu mã {ma} trong stderr "
                            f"{r.stderr[:160]!r}"
                        )
    finally:
        shutil.rmtree(work, ignore_errors=True)
    tong = len(cases) + len(cases_trap)
    print(
        f"# tổng: {tong} ca x 2 engine ({len(cases)} .out + {len(cases_trap)} .trap), "
        f"{len(hong)} hỏng",
        file=sys.stderr,
    )
    for x in hong[:30]:
        print("not ok -", x, file=sys.stderr)
    return 1 if hong else 0


if __name__ == "__main__":
    sys.exit(main())
