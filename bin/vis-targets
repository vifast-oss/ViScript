#!/usr/bin/env bash
# SPDX-License-Identifier: MIT OR Apache-2.0
# ST-74 (VD-104) — ma trận `cargo check --target` thật cho các crate ViScript.
# VD-242 Q6 / ST-156 — in **hai bảng có tên**, mỗi bảng một cấu hình, không trộn nhãn:
#   * `core (vis-cli --no-default-features)` — kỳ vọng xanh toàn bộ (không kéo rusqlite).
#   * `sqlite (vis-cli default, cấu hình cũ)` — giữ kết quả lịch sử; ô `vis-cli` × msvc/wasm32
#     đỏ vì C toolchain ⇒ in `EXPECTED_RED` + lý do (nợ #156).
#
# **ST-310f**: phủ **100% crate workspace** (23/23 − vis-cli là ô có kỳ vọng riêng) thay vì
# 8 crate lõi; thêm `vis-core`, `vis-host-native`, `vis-pkg`, `vis-loader`, `vis-lsp`, `vish-edit`,
# `vis-plugin-abi`, `vis-plugin-host`, `vis-plugin-macros`, `vish-term`.
# **ST-312b/ST-312c (VD-289)**: `vis-host-linux` + `vis-hir` nay là thành viên workspace
# (kiểm như mọi crate); chỉ `vis-host-wasm` còn ở khối `EXTRA`.
#
# Mức bằng chứng: **chỉ CHECK biên dịch chéo**; KHÔNG chạy trên Windows/wasm.
# 23 crate × 2 target + 1 crate phụ = 47 ô mỗi cấu hình. `std::process`/`std::net`/`std::fs`
# vẫn **biên dịch** cho wasm32 nhưng KHÔNG chạy được (wasm32-unknown-unknown không có
# tiến trình/socket/FS); CHECK xanh không phải bằng chứng hỗ trợ runtime.
# Exit 0 chỉ khi **mỗi** cấu hình đạt kỳ vọng riêng; ô đỏ đúng nợ cũ phải là EXPECTED_RED
# có lý do, không được im lặng coi là xanh hay đổi cấu hình rồi đổi nhãn.
#
# ST-300 — thêm **báo cáo** `wasm32-wasip1 (runtime)` (không phải ô cargo check): coverage
# `test/sem` eligible + suite runtime + known gaps, để không tuyên bố "full" khi còn 2 stack
# overflow interp. Row này **không** tham gia PASS/FAIL của hai ma trận check.
set -u
# **ST-314a (hậu-kiểm low-peak)**: `--wasm` đo lại runtime WASI; mặc định chỉ in **mốc lần đo cuối**
# (trước đây in hằng số 390/390, 28/28 như thể vừa đo — bằng chứng sai thời điểm).
WASM_DO=0
for _arg in "$@"; do
  case "$_arg" in
    --wasm) WASM_DO=1 ;;
    -h | --help)
      sed -n '2,30p' "$0"
      exit 0
      ;;
    *)
      echo "vis-targets: không hiểu \`$_arg\` (dùng --wasm để đo lại WASI)" >&2
      exit 2
      ;;
  esac
done
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
MANIFEST="$ROOT/Cargo.toml"
CARGO="${CARGO:-$HOME/.cargo/bin/cargo}"
TARGETS=(x86_64-pc-windows-msvc wasm32-unknown-unknown)
# **ST-310a/ST-310c (VD-285)** — thêm `vis-core` (tầng đáy DAG) và `vis-plugin-host`
# (host loader WASI) vào ma trận; hai crate này xuất hiện sau khi ST-310f viết danh sách 16 crate.
CRATES=(vis-core vis-hir vis-http vis-runtime vis-conformance vis-diag vis-syntax vis-types vis-bytecode vis-fmt vis-interp vis-vm vis-cli \
        vis-host-native vis-pkg vis-loader vis-lsp vish-edit vis-plugin-abi \
        vis-plugin-host vis-plugin-macros vish-term vis-host-linux)
EXTRA=("vis-host-wasm wasm32-unknown-unknown")
LOG="${TMPDIR:-/tmp}/vis-targets.$$.log"
trap 'rm -f "$LOG"' EXIT

# Cùng thứ tự dò Python với `bin/vis-dev`/`bin/vis-dag-check`.
PYTHON="${PYTHON:-}"
if [ -z "$PYTHON" ]; then
  for c in python3.12 python3.11 python3; do
    if command -v "$c" >/dev/null 2>&1; then PYTHON="$c"; break; fi
  done
fi
if [ -z "$PYTHON" ]; then
  echo "vis-targets: không thấy python3/python3.12" >&2
  exit 2
fi

# **ST-310f** — canh `CRATES` khớp **100%** `[workspace].members` của `Cargo.toml`.
# Thêm/bớt crate mà quên cập nhật ma trận ⇒ FAIL rõ, không lặng lẽ bỏ sót.
check_workspace_coverage() {
  local actual
  actual=$("$CARGO" metadata --manifest-path "$MANIFEST" --no-deps --format-version 1 2>/dev/null \
    | "$PYTHON" -c 'import json,sys; print("\n".join(sorted(p["name"] for p in json.load(sys.stdin)["packages"])))' \
    | tr -d '\r')
  if [ -z "$actual" ]; then
    echo "vis-targets: không đọc được workspace metadata từ $MANIFEST" >&2
    return 1
  fi
  local expected missing extra
  expected=$(printf '%s\n' "${CRATES[@]}" | LC_ALL=C sort -u)
  missing=$(comm -23 <(printf '%s\n' "$actual") <(printf '%s\n' "$expected"))
  extra=$(comm -13 <(printf '%s\n' "$actual") <(printf '%s\n' "$expected"))
  if [ -n "$missing" ] || [ -n "$extra" ]; then
    [ -n "$missing" ] && printf 'vis-targets: thiếu crate workspace: %s\n' "$(echo $missing)" >&2
    [ -n "$extra" ] && printf 'vis-targets: crate không có trong workspace: %s\n' "$(echo $extra)" >&2
    return 1
  fi
  echo "vis-targets: phủ 100% workspace (${#CRATES[@]} crate)"
}
check_workspace_coverage || exit 2

# **ST-313c (VD-289)** — khoá DAG 5 tầng: cạnh sản phẩm cấm (xem `bin/vis-dag-check`).
if ! CARGO="$CARGO" bash "$ROOT/bin/vis-dag-check"; then
  echo "vis-targets: DAG 5 tầng bị vi phạm" >&2
  exit 2
fi

CORE_LABEL="core (vis-cli --no-default-features)"
SQLITE_LABEL="sqlite (vis-cli default, cấu hình cũ)"
LY_DO="#156 (sqlite) + VS3-4a ring: libsqlite3-sys/ring cần C toolchain (cc-rs: thiếu lib.exe / cc) — chỉ CHECK, chưa chạy; xem agent/archive/reports/TARGET-MATRIX-2026-11-20.md"

# Ô đỏ đã biết ở cấu hình sqlite (không phải ở core).
expected_red() {
  local c="$1" t="$2"
  [ "$c" = "vis-cli" ] || return 1
  [ "$t" = "x86_64-pc-windows-msvc" ] || [ "$t" = "wasm32-unknown-unknown" ]
}

# check_one <manifest> [cargo flags...] — ghi log vào $LOG, trả mã thoát của cargo.
check_one() {
  local manifest="$1"; shift
  "$CARGO" check --manifest-path "$manifest" "$@" >"$LOG" 2>&1
}

# run_matrix <tên bảng> [cargo flags...] — trả số ô kỳ vọng xanh mà bị đỏ.
run_matrix() {
  local label="$1"; shift
  local -a flags=("$@")
  local pass=0 expected=0 bad=0 c t e
  printf '\n=== %s ===\n' "$label"
  printf '%-16s %-28s %s\n' crate target result
  for t in "${TARGETS[@]}"; do
    for c in "${CRATES[@]}"; do
      if check_one "$MANIFEST" "${flags[@]}" -p "$c" --target "$t"; then
        printf '%-16s %-28s %s\n' "$c" "$t" PASS
        if [ "$label" = "$SQLITE_LABEL" ] && expected_red "$c" "$t"; then
          printf '  lưu ý: ô từng EXPECTED_RED (#156) nay xanh — cần rà soát lại nợ #156\n'
        fi
        pass=$((pass + 1))
      elif [ "$label" = "$SQLITE_LABEL" ] && expected_red "$c" "$t"; then
        printf '%-16s %-28s %s\n' "$c" "$t" EXPECTED_RED
        grep -m1 -E '^error' "$LOG" | sed 's/^/  /'
        printf '  ly do: %s\n' "$LY_DO"
        expected=$((expected + 1))
      else
        printf '%-16s %-28s %s\n' "$c" "$t" FAIL
        grep -m2 -E '^error' "$LOG" | sed 's/^/  /'
        bad=$((bad + 1))
      fi
    done
  done
  for e in "${EXTRA[@]}"; do
    set -- $e
    c=$1; t=$2
    if check_one "$ROOT/$c/Cargo.toml" "${flags[@]}" --target "$t"; then
      printf '%-16s %-28s %s\n' "$c" "$t" PASS
      pass=$((pass + 1))
    else
      printf '%-16s %-28s %s\n' "$c" "$t" FAIL
      grep -m2 -E '^error' "$LOG" | sed 's/^/  /'
      bad=$((bad + 1))
    fi
  done
  printf '%s: PASS=%d EXPECTED_RED=%d FAIL=%d\n' "$label" "$pass" "$expected" "$bad"
  return "$bad"
}

run_matrix "$CORE_LABEL" --no-default-features
core_bad=$?
run_matrix "$SQLITE_LABEL"
sqlite_bad=$?

if [ "$core_bad" -ne 0 ] || [ "$sqlite_bad" -ne 0 ]; then
  echo "vis-targets: core FAIL=$core_bad, sqlite FAIL=$sqlite_bad (ô kỳ vọng xanh bị đỏ)" >&2
  exit 1
fi
echo
if [ "$WASM_DO" = 1 ]; then
  echo "=== wasm32-wasip1 (runtime) — ĐO LẠI trong lượt này ==="
  printf '%-24s %-28s %s\n' hạng-mục target kết-quả
  sem_out="$(cd "$ROOT" && ./bin/vis-wasm-sem 2>&1)"; sem_rc=$?
  # `--require-runtime`: thiếu runtime là exit 2, không được coi là "đo xong" (W4 F4).
  suite_out="$(cd "$ROOT" && ./bin/vis-wasm-suite --require-runtime 2>&1)"; suite_rc=$?
  conf_out="$(cd "$ROOT" && ./bin/vis-wasm-conformance 2>&1)"; conf_rc=$?
  sem_sum="$(printf '%s\n' "$sem_out" | sed -n 's/^# SUMMARY /sem /p' | tail -1)"
  suite_sum="$(printf '%s\n' "$suite_out" | sed -n 's/^# tổng: /suite /p' | tail -1)"
  conf_sum="$(printf '%s\n' "$conf_out" | sed -n 's/^# tổng: /conformance /p' | tail -1)"
  printf '%-24s %-28s %s\n' vis-wasm-sem wasm32-wasip1 "${sem_sum:-FAIL (exit $sem_rc)}"
  printf '%-24s %-28s %s\n' vis-wasm-suite wasm32-wasip1 "${suite_sum:-FAIL (exit $suite_rc)}"
  printf '%-24s %-28s %s\n' vis-wasm-conformance wasm32-wasip1 "${conf_sum:-FAIL (exit $conf_rc)}"
  printf '%-24s %-28s %s\n' coverage-note wasm32-wasip1 "eligible only; KHÔNG tuyên bố full support"
  # **ST-314a (W4 F4)**: thiếu summary (harness tự skip/BLOCKED-ENV) cũng là FAIL — trước đây
  # chỉ in "FAIL (exit 0)" rồi vẫn "đo lại OK" và exit 0.
  if [ -z "$sem_sum" ] || [ -z "$suite_sum" ] || [ -z "$conf_sum" ]; then
    echo "vis-targets: thiếu summary WASI (sem='$sem_sum' suite='$suite_sum' conf='$conf_sum') — coi là FAIL" >&2
    exit 1
  fi
  if [ "$sem_rc" -ne 0 ] || [ "$suite_rc" -ne 0 ] || [ "$conf_rc" -ne 0 ]; then
    echo "vis-targets: đo WASI có lỗi (sem=$sem_rc suite=$suite_rc conformance=$conf_rc)" >&2
    exit 1
  fi
  echo "wasm32-wasip1: đo lại OK (sem/suite/conformance ở trên); #193 đã đóng bằng stack module + V8"
else
  echo "=== wasm32-wasip1 (runtime) — CHƯA ĐO trong lượt này ==="
  printf '%-24s %-28s %s\n' hạng-mục target kết-quả
  # **ST-316c**: mốc dưới đây lấy từ log THẬT `st316c-wasm-20261126T1613Z.log`
  # (HEAD `29a7b254`, `--wasm` exit 0, 2026-11-26T16:16:38Z). Lịch sử: 379×2 (354+25) trước
  # `fbb0ae4f`; 393×2 (366+27) là r072 trên cây **trước Sóng 5** (412 `.out`); ST-316a thêm 2 ca
  # `stdlib/edge_map` (414 `.out`) ⇒ 395×2 (368+27), không phải lỗi harness.
  printf '%-24s %-28s %s\n' vis-wasm-sem wasm32-wasip1 "chưa đo lượt này; lần cuối 2026-11-26: 390/390"
  printf '%-24s %-28s %s\n' vis-wasm-suite wasm32-wasip1 "chưa đo lượt này; lần cuối 2026-11-26: 28/28"
  printf '%-24s %-28s %s\n' vis-wasm-conformance wasm32-wasip1 "chưa đo lượt này; lần cuối 2026-11-26: 395×2 (368 .out + 27 .trap)"
  printf '%-24s %-28s %s\n' nguồn-wasm wasm32-wasip1 "st316c-wasm-20261126T1613Z.log:123 (HEAD 29a7b254, exit 0)"
  printf '%-24s %-28s %s\n' coverage-note wasm32-wasip1 "eligible only; KHÔNG tuyên bố full support"
  echo "wasm32-wasip1: mốc lần cuối 2026-11-26; chạy \`bin/vis-targets --wasm\` để đo lại"
fi
echo
echo "=== aarch64-apple-darwin (native) ==="
printf '%-24s %-28s %s\n' hạng-mục target kết-quả
printf '%-24s %-28s %s\n' vis-release aarch64-apple-darwin "PASS — chỉ vis, không test-child (ST-300m1/mps)"
printf '%-24s %-28s %s\n' gate-macos aarch64-apple-darwin "quick/full qua bin/vis-gate-macos (không cross-check)"
echo "aarch64-apple-darwin (native): release chỉ vis; bằng chứng chạy thật trên mps, không phải cargo check chéo"
echo "vis-targets: cả hai cấu hình đạt kỳ vọng riêng (chỉ CHECK, chưa chạy trên Windows/wasm)"
