#!/usr/bin/env bash
# SPDX-License-Identifier: MIT OR Apache-2.0
# **ST-313c (VD-289)** — khoá DAG 5 tầng: kiểm các cạnh **cấm** giữa crate.
#
# Dùng `cargo metadata --no-deps` (không build); lỗi ⇒ exit 2 kèm cạnh vi phạm.
# Gọi từ `bin/vis-targets` (cổng cuối Sóng) và `vis-dev check`/`gate --fast` (ST-314a) để hồi quy
# kiến trúc không lọt.
set -u
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
if [ -n "${CARGO:-}" ]; then
    if ! command -v "$CARGO" >/dev/null 2>&1; then
        echo "vis-dag-check: CARGO không chạy được: $CARGO" >&2
        exit 2
    fi
else
    CARGO="$HOME/.cargo/bin/cargo"
    command -v "$CARGO" >/dev/null 2>&1 || CARGO=cargo
fi
# Cùng thứ tự dò Python với `bin/vis-dev`; hỗ trợ host chỉ có python3.12/3.11.
PYTHON="${PYTHON:-}"
if [ -z "$PYTHON" ]; then
    for c in python3.12 python3.11 python3; do
        if command -v "$c" >/dev/null 2>&1; then PYTHON="$c"; break; fi
    done
fi
if [ -z "$PYTHON" ]; then
    echo "vis-dag-check: không thấy python3/python3.12" >&2
    exit 2
fi

META="$(mktemp "${TMPDIR:-/tmp}/vis-dag-meta.XXXXXX")"
trap 'rm -f "$META"' EXIT
if ! "$CARGO" metadata --manifest-path "$ROOT/Cargo.toml" --no-deps --format-version 1 >"$META" 2>/dev/null; then
    echo "vis-dag-check: không đọc được cargo metadata" >&2
    exit 2
fi
"$PYTHON" - "$META" <<'PY'
import json, sys

# Windows console mặc định cp1252 — ép UTF-8 để in thông điệp tiếng Việt không lỗi.
for s in (sys.stdout, sys.stderr):
    if hasattr(s, "reconfigure"):
        s.reconfigure(encoding="utf-8", errors="replace")

with open(sys.argv[1], encoding="utf-8") as f:
    data = json.load(f)
# Chỉ cạnh **sản phẩm** (`kind` null = normal); dev/build không tính vào DAG.
deps = {
    p["name"]: {d["name"] for d in p["dependencies"] if d.get("kind") in (None, "normal")}
    for p in data["packages"]
}

# Cạnh **cấm** (trái→phải): tầng dưới không được kéo tầng trên/ngang sai DAG.
# **ST-314a low-peak**: ngoài bảng cùng tầng bên dưới, kiểm **toàn bộ 23 crate** theo 5 tầng
# (`docs/ViScript-thiet-ke.md` §14) — mọi cạnh xuôi lên tầng trên đều bị chặn, không chỉ 7 crate.
# Các mục **ngược tầng** trong CAM_NGANG là tài liệu chính sách (bảng tầng đã bắt); các mục
# **cùng tầng** mới là ràng buộc bổ sung thực sự.
CAM_NGANG = {
    "vis-core":      {"vis-types", "vis-http", "vis-runtime", "vis-interp", "vis-vm", "vis-pkg"},
    "vis-hir":       {"vis-types", "vis-runtime", "vis-interp", "vis-vm", "vis-pkg"},
    "vis-http":      {"vis-types", "vis-runtime", "vis-interp", "vis-vm", "vis-pkg", "vis-host-native"},
    "vis-types":     {"vis-bytecode", "vis-runtime", "vis-interp", "vis-vm"},
    "vis-bytecode":  {"vis-types", "vis-interp", "vis-vm", "vis-runtime"},
    "vis-vm":        {"vis-types", "vis-interp"},
    "vis-runtime":   {"vis-types", "vis-interp", "vis-vm"},
    "vis-pkg":       {"vis-host-native"},
    # **ST-316d (VD-292 §4.1)** — tầng Host không được kéo tầng Runtime: `src/` của
    # `vis-host-native` có 0 tham chiếu `vis-runtime` (chỉ test HTTP/2 dùng ⇒ dev-dependency).
    "vis-host-native": {"vis-runtime"},
}
TANG_CUA = {
    "vis-diag": 0,
    "vis-syntax": 0,
    "vis-fmt": 0,
    "vis-plugin-abi": 0,
    "vish-term": 0,
    "vis-hir": 1,
    "vis-core": 1,
    "vis-http": 1,
    "vis-types": 2,
    "vis-bytecode": 2,
    "vis-runtime": 2,
    "vis-interp": 2,
    "vis-vm": 2,
    "vis-loader": 3,
    "vis-lsp": 3,
    "vis-pkg": 3,
    "vis-host-native": 3,
    "vis-host-linux": 3,
    "vis-plugin-host": 3,
    "vis-plugin-macros": 3,
    "vish-edit": 3,
    "vis-cli": 4,
    "vis-conformance": 4,
}
loi = []
for crate in sorted(set(TANG_CUA) - set(deps)):
    loi.append(f"thiếu crate `{crate}` trong workspace")
for crate in sorted(set(deps) - set(TANG_CUA)):
    loi.append(f"crate `{crate}` chưa khai tầng trong TANG_CUA")
for crate in sorted(set(CAM_NGANG) - set(TANG_CUA)):
    loi.append(f"CAM_NGANG: crate lạ `{crate}`")
for dich in sorted(set().union(*CAM_NGANG.values()) - set(TANG_CUA)):
    loi.append(f"CAM_NGANG: đích lạ `{dich}`")
for crate, co in sorted(deps.items()):
    t = TANG_CUA.get(crate)
    if t is None:
        continue
    for d in sorted(co):
        td = TANG_CUA.get(d)
        if td is not None and td > t:
            loi.append(f"{crate}[T{t}] -> {d}[T{td}] (ngược tầng)")
    # Cạnh cùng tầng còn lại (các cạnh ngược tầng đã bị bảng tầng bắt ở trên).
    for d in sorted(CAM_NGANG.get(crate, set()) & co):
        td = TANG_CUA.get(d)
        if td is not None and td <= t:
            loi.append(f"{crate} -> {d} (cùng tầng/sai DAG)")
if loi:
    print("vis-dag-check: VI PHẠM DAG:", file=sys.stderr)
    for x in loi:
        print(f"  {x}", file=sys.stderr)
    sys.exit(2)
print(f"vis-dag-check: OK — {len(TANG_CUA)} crate / 5 tầng, 0 cạnh cấm")
PY
