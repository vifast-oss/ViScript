#!/usr/bin/env bash
# SPDX-License-Identifier: MIT OR Apache-2.0
# **ST-296d-tools / VD-282(3)** — `vis-gate-windows --quick|--full` trên `psvn` qua `vis-remote`.
#
#   --quick : suite trọng yếu (cancel/select/h2/pkg), nhanh
#   --full  : clippy (`--workspace --all-targets -D warnings`) + `cargo test --workspace
#             --no-fail-fast` + host conformance + targets
#
# Mặc định dùng repo sạch trên psvn; có thể đổi bằng `VIS_GATE_WINDOWS_REPO` (đường dẫn Windows/
# Git Bash) và `VIS_GATE_WINDOWS_REMOTE` (mặc định `psvn`). `VIS_GATE_WINDOWS_TMPDIR` mặc định
# `/c/Users/ps/tmp` (ngoài `/tmp` tmpfs). Không tag/push/merge; không GitHub Actions.
set -u
MODE=""
DRY=0
while [ $# -gt 0 ]; do
    case "$1" in
        --quick | --full)
            # **ST-314a (hậu-kiểm low-peak)**: trước đây `--quick --full` im lặng lấy cờ sau (argv last-wins).
            [ -z "$MODE" ] || { echo "vis-gate-windows: chỉ nhận một trong --quick/--full" >&2; exit 2; }
            MODE="$1"
            ;;
        --dry-run) DRY=1 ;;
        -h | --help) sed -n '2,18p' "$0"; exit 0 ;;
        *) echo "vis-gate-windows: đối số không hiểu: $1" >&2; exit 2 ;;
    esac
    shift
done
if [ -z "$MODE" ]; then
    echo "vis-gate-windows: cần --quick hoặc --full" >&2
    exit 2
fi
REPO="$(cd "$(dirname "$0")/.." && pwd)"
REMOTE="${VIS_GATE_WINDOWS_REMOTE:-psvn}"
DEST="${VIS_GATE_WINDOWS_REPO:-/c/Users/ps/viscript-moi}"
TMP="${VIS_GATE_WINDOWS_TMPDIR:-/c/Users/ps/tmp}"
LOG="${VIS_GATE_WINDOWS_LOG:-/tmp/vis-gate-windows-${MODE#--}-$(date -u +%Y%m%dT%H%M%SZ).log}"

if [ "$MODE" = "--quick" ]; then
    # **ST-296a / ST-311c**: `vs3_http_cancel` nay thuộc `vis-host-native --test http2_it`.
    # **ST-314a (hậu-kiểm low-peak)**: `vs3_select::` đã chuyển sang `vis-conformance/tests/lib_api_it.rs`; filter
    # cũ trên `vis-cli --test async_it` khớp 0 ca và libtest vẫn exit 0 ⇒ PASS giả. `f` đòi
    # ít nhất 1 test thật đã chạy cho **mỗi** lệnh lọc.
    GUARD='f() { o="$("$@" 2>&1)"; r=$?; printf "%s\n" "$o"; [ "$r" -eq 0 ] || return "$r"; printf "%s\n" "$o" | grep -Eq "test result: ok\. [1-9][0-9]* passed"; }; '
    body="${GUARD}export TMPDIR='$TMP' TMP='$TMP' TEMP='$TMP'; cd '$DEST' && f cargo test -p vis-cli --test net_pkg_it pkg:: -- --skip siet_caps_pkg && f cargo test -p vis-host-native --features http2,async-h2 --test http2_it && f cargo test -p vis-conformance --test lib_api_it vs3_select::"
else
    body="export TMPDIR='$TMP' TMP='$TMP' TEMP='$TMP'; cd '$DEST' && cargo clippy --workspace --all-targets -- -D warnings && cargo test --workspace --no-fail-fast && cargo test -p vis-cli --test host_conformance -- --nocapture && bash bin/vis-targets"
fi
echo "vis-gate-windows: mode=${MODE#--} remote=$REMOTE repo=$DEST tmp=$TMP" >&2
if [ "$DRY" -eq 1 ]; then
    echo "vis-remote $REMOTE --require-clean --log $LOG -- bash -lc '$body'"
    exit 0
fi
# **ST-314a (hậu-kiểm low-peak)**: HEAD GUARD — `vis-remote` KHÔNG đồng bộ cây nguồn, nên trước
# đây cổng có thể chạy trên commit CŨ ở `$DEST` mà vẫn exit 0 (bằng chứng sai HEAD). So HEAD thật
# của repo trên máy đích với HEAD cục bộ; lệch ⇒ từ chối (exit 6), trừ khi người dùng chấp nhận rõ
# bằng `VIS_GATE_WINDOWS_ALLOW_HEAD_MISMATCH=1` (chỉ dùng khi cố ý đo commit khác).
if [ "${VIS_GATE_WINDOWS_ALLOW_HEAD_MISMATCH:-0}" != "1" ]; then
    local_head="$(git -C "$REPO" rev-parse HEAD 2>/dev/null || true)"
    probe="$("$REPO/bin/vis-remote" "$REMOTE" --check 2>/dev/null || true)"
    remote_head="$(printf '%s\n' "$probe" | sed -n 's/^head_full: //p' | head -1)"
    if [ -z "$remote_head" ] || [ "$remote_head" = "?" ]; then
        echo "vis-gate-windows: không đọc được HEAD của repo trên '$REMOTE' — từ chối chạy (BLOCKED-ENV)" >&2
        exit 3
    fi
    if [ -n "$local_head" ] && [ "$local_head" != "$remote_head" ]; then
        echo "vis-gate-windows: HEAD LỆCH — local ${local_head:0:12}, $REMOTE ${remote_head:0:12}" >&2
        echo "vis-gate-windows: đồng bộ trước: bin/vis-remote $REMOTE -- git -C $DEST pull --ff-only" >&2
        echo "vis-gate-windows: (hoặc VIS_GATE_WINDOWS_ALLOW_HEAD_MISMATCH=1 nếu cố ý đo commit khác)" >&2
        exit 6
    fi
    echo "vis-gate-windows: HEAD khớp ${local_head:0:12}" >&2
fi
exec "$REPO/bin/vis-remote" "$REMOTE" --require-clean --log "$LOG" -- bash -lc "$body"
