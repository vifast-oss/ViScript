#!/usr/bin/env bash
# SPDX-License-Identifier: MIT OR Apache-2.0
# vis-linux — chạy lệnh của dòng ViScript trên một nền **Linux thật** (ST-121, VD-120).
#
# Vì sao cần: macOS chỉ cho bằng chứng "biên dịch kiểm tra" (VD-104). Các hạng mục còn
# thiếu của VS2 (Landlock thật, hợp chuẩn host nền thứ hai, đo lại toàn bộ số khoá trên
# kernel Linux) chỉ đóng được khi có một nền Linux **chạy được**, rồi đo ở đó.
#
# Hai backend:
#   ssh    — đồng bộ cây nguồn sang một host Linux qua ssh rồi chạy ở đó.
#            Backend **đã đo**: kernel thật, `/sys/kernel/security/lsm` có `landlock`,
#            **không** có seccomp của container chen giữa ⇒ bằng chứng Landlock sạch hơn.
#   docker — build + chạy trong container từ `infra/linux/Dockerfile`.
#            Container có seccomp mặc định có thể chặn syscall landlock; khi đó `probe`
#            in rõ "BỊ CHẶN" và **không** tự nới (ST-121).
#
# Dùng:
#   bin/vis-linux probe [--log <tệp>]       # nền, kernel, lsm, syscall landlock, phiên bản cargo
#   bin/vis-linux setup [--log <tệp>]       # tái lập toolchain (infra/linux/setup.sh): rustup target + log digest
#   bin/vis-linux sync                      # chỉ đồng bộ cây nguồn
#   bin/vis-linux run [--] <lệnh> [đối số…] # chạy lệnh trong cây đã đồng bộ (tự gọi setup trước)
#   bin/vis-linux gate                      # lối tắt: run bash viscript/bin/vis-dev gate --fast
#   bin/vis-linux shell                     # ssh tương tác / docker shell
#
# Biến môi trường:
#   VIS_LINUX_SSH      đích ssh (mặc định `root@ps`); rỗng ⇒ bỏ backend ssh
#   VIS_LINUX_DIR      thư mục cây nguồn trên host (mặc định `/root/vifast-linux`)
#   VIS_LINUX_BACKEND  auto | ssh | docker   (mặc định auto: ssh nếu ssh được, ngược lại docker)
#   VIS_LINUX_IMAGE    tên image docker (mặc định `vifast-viscript-linux`)
#   VIS_LINUX_NO_SYNC  =1 ⇒ không rsync trước khi chạy (dùng cây đang có trên host)
#   VIS_LINUX_NO_SETUP =1 ⇒ không gọi infra/linux/setup.sh trước khi chạy (ST-134, VD-136)
#
# Mã thoát: 0 xanh · 1 lệnh trên host trả lỗi · 2 dùng sai · 3 BLOCKED-ENV (không có nền Linux)
set -u

VIS_ROOT="$(cd "$(dirname "$0")/.." && pwd)"
REPO_ROOT="$(cd "$VIS_ROOT/.." && pwd)"
SSH_TARGET="${VIS_LINUX_SSH-root@ps}"
LINUX_DIR="${VIS_LINUX_DIR:-/root/vifast-linux}"
BACKEND="${VIS_LINUX_BACKEND:-auto}"
IMAGE="${VIS_LINUX_IMAGE:-vifast-viscript-linux}"
no_sync="${VIS_LINUX_NO_SYNC:-0}"
docker_bin=""
BE=""

die() { echo "vis-linux: $2" >&2; exit "$1"; }
say() { echo "vis-linux: $*" >&2; }

ssh_ok() {
    [ -n "$SSH_TARGET" ] || return 1
    ssh -o BatchMode=yes -o ConnectTimeout=8 "$SSH_TARGET" true >/dev/null 2>&1
}

find_docker() {
    [ -n "$docker_bin" ] && return 0
    local c
    for c in docker podman nerdctl; do
        if command -v "$c" >/dev/null 2>&1; then docker_bin="$c"; return 0; fi
    done
    return 1
}

# Đặt $BE. Chạy trong shell hiện tại (không dùng $(…)) để `die` thoát đúng.
pick_backend() {
    case "$BACKEND" in
        ssh)
            ssh_ok || die 3 "backend ssh: không ssh được tới '$SSH_TARGET' (BLOCKED-ENV)"
            BE=ssh ;;
        docker)
            find_docker || die 3 "backend docker: không thấy docker/podman/nerdctl (BLOCKED-ENV)"
            BE=docker ;;
        auto)
            if ssh_ok; then
                BE=ssh
            elif find_docker; then
                BE=docker
            else
                die 3 "không có nền Linux nào: không ssh được '$SSH_TARGET' và không có docker/podman/nerdctl/colima (BLOCKED-ENV)"
            fi ;;
        *) die 2 "VIS_LINUX_BACKEND='$BACKEND' không hợp lệ (auto|ssh|docker)" ;;
    esac
}

# Đồng bộ cây nguồn sang host. `--delete` chỉ trong các cây con **của dòng ViScript**,
# không bao giờ đồng bộ `crates/`, `v2/` (hai dòng sản phẩm dùng chung một repo).
sync_tree() {
    if [ "$no_sync" = 1 ]; then say "bỏ đồng bộ (VIS_LINUX_NO_SYNC=1)"; return 0; fi
    local d
    # `vis-host-linux`/`vis-host-wasm` ở gốc repo (R4 cấm nằm trong `viscript/`): cần cho ST-132
    # (Landlock thật) và cho ma trận `bin/vis-targets` (ô `vis-host-wasm × wasm32`) — ST-134.
    for d in viscript docs/viscript vis-host-linux vis-host-wasm .git; do
        [ -e "$REPO_ROOT/$d" ] || continue
        rsync -a --delete --exclude 'target/' --exclude '*.rlib' \
            "$REPO_ROOT/$d/" "$SSH_TARGET:$LINUX_DIR/$d/" ||
            die 3 "rsync '$d' thất bại (BLOCKED-ENV)"
    done
    rsync -a "$REPO_ROOT/AGENTS.md" "$SSH_TARGET:$LINUX_DIR/AGENTS.md" 2>/dev/null || true
    # ST-143: hai shim gốc repo (`vis-dev`, `vis`) — AGENTS §6 gọi `./vis-dev`/`./vis`. Thiếu chúng thì
    # `../vis-dev` trong `viscript/` **không tồn tại** trên host ⇒ gate của `vis-soak` exit 127 (ST-140 gặp:
    # `JOURNAL/st140-gate-ps-lan1-sai-duong-dan.log`). Không `--delete`, không nới quyền: chỉ thêm hai tệp.
    for d in vis-dev vis; do
        [ -e "$REPO_ROOT/$d" ] || continue
        rsync -a "$REPO_ROOT/$d" "$SSH_TARGET:$LINUX_DIR/$d" ||
            die 3 "rsync '$d' thất bại (BLOCKED-ENV)"
    done
    say "đã đồng bộ → $SSH_TARGET:$LINUX_DIR"
}

ssh_script() { # stdin = script; $1 = thư mục làm việc
    ssh -o BatchMode=yes "$SSH_TARGET" \
        "cd $(printf '%q' "$1") && export PATH=\"\$HOME/.cargo/bin:\$PATH\" && exec bash -s"
}

# Thân chương trình dò, chạy **trên Linux**. Không cài gì, không sửa gì.
probe_body() {
    cat <<'EOS'
set -u
export PATH="$HOME/.cargo/bin:/usr/local/bin:/usr/bin:/bin:$PATH"
echo "== nền =="
uname -srm
( . /etc/os-release 2>/dev/null && echo "os: $PRETTY_NAME" ) || true
echo "nproc: $(nproc 2>/dev/null || echo '?')"
echo "== công cụ =="
for c in cargo rustc python3; do
    if command -v "$c" >/dev/null 2>&1; then printf '%s: %s\n' "$c" "$("$c" --version 2>&1 | head -1)"; else echo "$c: none"; fi
done
echo "cargo (đường dẫn): $(command -v cargo 2>/dev/null || echo none)"
echo "== lsm =="
if [ -r /sys/kernel/security/lsm ]; then
    lsm="$(cat /sys/kernel/security/lsm)"
    echo "lsm: $lsm"
    case "$lsm" in *landlock*) echo "landlock trong lsm: CÓ" ;; *) echo "landlock trong lsm: KHÔNG" ;; esac
else
    echo "lsm: không đọc được /sys/kernel/security/lsm"
fi
echo "== syscall landlock =="
python3 - <<'PY' 2>/dev/null || echo "landlock syscall: không dò được (không có python3)"
import ctypes, errno, os
# landlock_create_ruleset(2) = 444 trên x86_64 và aarch64; flags=1 (VERSION) ⇒ trả ABI version.
libc = ctypes.CDLL(None, use_errno=True)
ctypes.set_errno(0)
r = libc.syscall(444, ctypes.c_void_p(0), ctypes.c_size_t(0), ctypes.c_uint32(1))
e = ctypes.get_errno()
if r > 0:
    print("landlock syscall: CÓ (ABI=%d)" % r)
elif e in (errno.ENOSYS, errno.EOPNOTSUPP):
    print("landlock syscall: KHÔNG (errno=%d %s)" % (e, os.strerror(e)))
else:
    print("landlock syscall: BỊ CHẶN (errno=%d %s) — seccomp/LSM, không tự nới" % (e, os.strerror(e)))
PY
echo "== quyền ghi =="
for d in "$HOME/.cargo" /tmp; do [ -w "$d" ] && echo "ghi được: $d" || echo "KHÔNG ghi được: $d"; done
EOS
}

build_image() {
    find_docker || die 3 "mất docker giữa chừng (BLOCKED-ENV)"
    "$docker_bin" build -t "$IMAGE" -f "$VIS_ROOT/infra/linux/Dockerfile" "$VIS_ROOT/infra/linux" ||
        die 3 "build image thất bại (BLOCKED-ENV)"
}

docker_run() { # $@ = lệnh
    find_docker || die 3 "mất docker giữa chừng (BLOCKED-ENV)"
    "$docker_bin" run --rm -i \
        -v "$REPO_ROOT:/src:ro" \
        -v vifast-viscript-target:/target \
        -w /src "$IMAGE" "$@"
}

write_log() { # $1 = nội dung, $2 = tệp
    printf '%s\n' "$1" >"$2"
    echo "sha256: $(sha256_stdin <"$2")"
    echo "log: $2"
}

sha256_stdin() {
    if command -v shasum >/dev/null 2>&1; then shasum -a 256 | cut -d' ' -f1
    elif command -v sha256sum >/dev/null 2>&1; then sha256sum | cut -d' ' -f1
    else echo "khong-co-sha256"; fi
}

# **ST-134 (VD-136)**: bước tái lập toolchain trong repo (`infra/linux/setup.sh`) — chỉ rustup
# target, idempotent. Chạy **sau** sync/build, **trước** lệnh cần đo. Tắt bằng VIS_LINUX_NO_SETUP=1.
setup_body() {
    if [ "${VIS_LINUX_NO_SETUP:-0}" = 1 ]; then
        say "bỏ setup toolchain (VIS_LINUX_NO_SETUP=1)"
        return 0
    fi
    local out
    case "$BE" in
        ssh)
            out="$(ssh -o BatchMode=yes "$SSH_TARGET" \
                "cd $(printf '%q' "$LINUX_DIR") && export PATH=\"\$HOME/.cargo/bin:\$PATH\" && bash viscript/infra/linux/setup.sh")" ||
                die 3 "setup toolchain trên '$SSH_TARGET' thất bại (BLOCKED-ENV)"
            ;;
        docker)
            out="$(docker_run bash viscript/infra/linux/setup.sh)" ||
                die 3 "setup toolchain trong container thất bại (BLOCKED-ENV)"
            ;;
        *) die 2 "setup: chưa chọn backend" ;;
    esac
    printf '%s\n' "$out"
}

# Gọi setup cho `run`/`gate`: chỉ in dòng tóm tắt (digest/target/setup) ra stderr để không đổi stdout.
run_setup() {
    local out
    if ! out="$(setup_body)"; then
        say "setup toolchain thất bại (BLOCKED-ENV) — bỏ qua bằng VIS_LINUX_NO_SETUP=1 nếu chỉ muốn đo môi trường hiện có"
        exit 3
    fi
    printf '%s\n' "$out" | grep -E '^(digest-toolchain|target |setup:)' >&2 || true
    return 0
}

cmd_setup() {
    local log=""
    while [ $# -gt 0 ]; do
        case "$1" in
            --log) log="${2:?--log cần tệp}"; shift 2 ;;
            *) die 2 "setup: đối số lạ '$1'" ;;
        esac
    done
    pick_backend
    say "backend=$BE"
    case "$BE" in
        ssh) sync_tree ;;
        docker) build_image ;;
    esac
    local out
    out="$(setup_body)" || return $?
    printf '%s\n' "$out"
    echo "sha256: $(printf '%s\n' "$out" | sha256_stdin)"
    [ -n "$log" ] && write_log "$out" "$log"
    return 0
}

cmd_probe() {
    local log=""
    while [ $# -gt 0 ]; do
        case "$1" in
            --log) log="${2:?--log cần tệp}"; shift 2 ;;
            *) die 2 "probe: đối số lạ '$1'" ;;
        esac
    done
    pick_backend
    say "backend=$BE"
    local out
    case "$BE" in
        ssh) sync_tree; out="$(probe_body | ssh_script "$LINUX_DIR")" || die 1 "probe trên '$SSH_TARGET' lỗi" ;;
        docker) build_image; out="$(probe_body | docker_run bash -s)" || die 1 "probe trong container lỗi" ;;
    esac
    printf '%s\n' "$out"
    [ -n "$log" ] && write_log "$out" "$log"
    return 0
}

cmd_run() {
    [ $# -gt 0 ] || die 2 "run: cần lệnh"
    [ "$1" = "--" ] && shift
    pick_backend
    case "$BE" in
        ssh)
            sync_tree
            run_setup
            local q="" a
            for a in "$@"; do q="$q $(printf '%q' "$a")"; done
            ssh -o BatchMode=yes "$SSH_TARGET" \
                "cd $(printf '%q' "$LINUX_DIR") && export PATH=\"\$HOME/.cargo/bin:\$PATH\" &&$q"
            ;;
        docker)
            build_image
            run_setup
            docker_run "$@"
            ;;
    esac
}

case "${1:-}" in
    probe) shift; cmd_probe "$@" ;;
    setup) shift; cmd_setup "$@" ;;
    sync) pick_backend; sync_tree ;;
    run) shift; cmd_run "$@" ;;
    gate) pick_backend; cmd_run bash viscript/bin/vis-dev gate --fast ;;
    shell)
        shift
        pick_backend
        case "$BE" in
            ssh) ssh -t "$SSH_TARGET" "cd $(printf '%q' "$LINUX_DIR") && exec bash -l" ;;
            docker) build_image; find_docker; exec "$docker_bin" run --rm -it -v "$REPO_ROOT:/src:ro" -v vifast-viscript-target:/target -w /src "$IMAGE" bash ;;
        esac
        ;;
    "" | -h | --help | help) sed -n '2,33p' "$0" | sed 's/^# \{0,1\}//' ;;
    *) die 2 "lệnh không hiểu: '$1' (probe|setup|sync|run|gate|shell)" ;;
esac
