#!/usr/bin/env bash
# SPDX-License-Identifier: MIT OR Apache-2.0
# vis-dev — cổng của dòng ViScript (ST-01).
#   check      : fmt + clippy + luật R1..R9 + self-test case âm + build
#   gate --fast: check + L0 test
#   nightly    : gate --fast + fuzz parser (--fuzz-minutes, mặc định 2) + vòng tròn fmt (idempotent)
set -u
# **SỬA KÈM LÝ DO (ST-147, VD-150)**: trên Windows (psvn) python3 ghi stdout/stderr bằng bảng mã
# console (cp1252) + backslashreplace, nên mọi chuỗi tiếng Việt của doc_examples.py / check_report.py
# ra `ph\u1ea3i \u0111�ng …` thay vì UTF-8 ⇒ `grep` của test/fixtures/run_fixtures.sh trượt và 7 ca
# "bị bắt nhưng sai lý do". Ép UTF-8 cho MỌI lần gọi python3 của cổng (doc-examples, check_report,
# self-test, fixture báo cáo) bằng biến môi trường kế thừa xuống tiến trình con. Không đổi kỳ vọng,
# không xoá ca, không nới ngưỡng; macOS/Linux vốn đã UTF-8 nên không đổi hành vi.
export PYTHONIOENCODING=utf-8
export PYTHONUTF8=1
# **SỬA KÈM LÝ DO (verify psvn)**: gawk trên Git Bash (MINGW) không khớp regex UTF-8
# (`/cú pháp sai/` trong rule R6) khi `LC_ALL` rỗng ⇒ R6 báo oan 8 dòng trong
# `docs/R30-MAU-2026-11-18.md`. Ép `C.UTF-8` (có trên cả ps/mps/psvn) để phần miễn
# trừ hoạt động; chỉ đặt khi `LC_ALL`chưa có giá trị — không đè lựa chọn người dùng.
export LC_ALL="${LC_ALL:-C.UTF-8}"

# **ST-296d-tools / VD-282(3)**: tự điều tiết build khi nhiều luồng chạy song song.
#   - `CARGO_PROFILE_DEV_DEBUG=0` (nếu người dùng chưa đặt): giảm target/, tăng tốc gate;
#   - `CARGO_BUILD_JOBS = max(2, nproc / active_jobs)` (nếu chưa đặt), active_jobs = số tiến
#     trình cargo/rustc/nextest đang chạy;
#   - dùng `sccache` nếu có trên PATH và người dùng chưa chọn `RUSTC_WRAPPER`.
# Không đè biến người dùng đã đặt; không đổi hành vi cổng.
if [ -z "${CARGO_PROFILE_DEV_DEBUG+x}" ]; then
    export CARGO_PROFILE_DEV_DEBUG=0
fi
if [ -z "${CARGO_BUILD_JOBS+x}" ]; then
    nproc_vis="$(getconf _NPROCESSORS_ONLN 2>/dev/null || sysctl -n hw.ncpu 2>/dev/null || echo 4)"
    case "$nproc_vis" in '' | *[!0-9]*) nproc_vis=4 ;; esac
    active_vis="$(ps -eo comm= 2>/dev/null | grep -Ec '^(cargo|rustc|cargo-nextest|nextest)$')"
    [ "${active_vis:-0}" -lt 1 ] && active_vis=1
    jobs_vis=$((nproc_vis / active_vis))
    [ "$jobs_vis" -lt 2 ] && jobs_vis=2
    export CARGO_BUILD_JOBS="$jobs_vis"
fi
if [ -z "${RUSTC_WRAPPER+x}" ] && command -v sccache >/dev/null 2>&1; then
    export RUSTC_WRAPPER=sccache
fi
VIS_ROOT="$(cd "$(dirname "$0")/.." && pwd)"
REPO_ROOT="$VIS_ROOT"
MANIFEST="$VIS_ROOT/Cargo.toml"
fails=0

# **VD-241 §3/T6 + nợ #185** — chọn cargo theo helper dùng chung với `bin/vis`.
# Không hardcode ưu tiên ~/.cargo/bin; in rõ người được chọn + yêu cầu.
# shellcheck source=_vis-toolchain.sh
source "$VIS_ROOT/bin/_vis-toolchain.sh"
CARGO="$(vis_find_cargo "vis-dev")" || exit 78
if [ -n "$CARGO" ]; then
    # Các bước python bên trong (doc-examples, check_report, fixture) gọi plain `cargo`;
    # đặt thư mục của cargo được chọn ở **đầu** PATH để cả cây con thấy bản đúng.
    CARGO_DIR="$(dirname "$CARGO")"
    case ":$PATH:" in
        *":$CARGO_DIR:"*) ;;
        *) export PATH="$CARGO_DIR:$PATH" ;;
    esac
    echo "vis-dev: chọn cargo $CARGO ($(vis_semver_of "$CARGO" || true); yêu cầu ≥ $(vis_required_rust_version))" >&2
fi
relpath() {
    case "$1" in
        "$VIS_ROOT"/*) printf '%s' "${1#"$VIS_ROOT"/}" ;;
        *) printf '%s' "$1" ;;
    esac
}

rule_fail() { echo "$1" >&2; fails=$((fails + 1)); }

# R6 (VD-205): **danh sách cấm** — cú pháp bị bỏ ở pha 1 không được xuất hiện ở
# `docs/**/*.md` lẫn `CHEAT-SHEET-ViScript.md` (quét **cả văn xuôi lẫn khối mã**).
#   Danh sách: `test/gate/cu-cam.txt` — mỗi dòng `<từ khoá ascii viết thường><TAB><lý do>`.
#   Ngoại lệ duy nhất: dòng chứa "cú pháp sai" (case-insensitive, ví dụ đánh dấu tường minh)
#     hoặc dòng khớp một mục của `test/gate/cu-cam-ngoai-le.txt` (chuỗi con, kèm lý do).
#   Cây không có tệp nào bị quét ⇒ bỏ qua (cây tạm của self-test R1..R4); cây có docs/ nhưng
#   thiếu danh sách ⇒ **đỏ** (chống "quên tạo tệp").
#   Một tiến trình `awk` cho toàn bộ — không tạo tiến trình mỗi dòng/mỗi tệp.
rule_forbidden_list() {
    local root="$1"
    local list="$root/test/gate/cu-cam.txt"
    local except="$root/test/gate/cu-cam-ngoai-le.txt"
    local f
    local -a scan=()
    if [ -d "$root/docs" ]; then
        while IFS= read -r -d '' f; do scan+=("$f"); done < <(find "$root/docs" -type f -name '*.md' -print0 2>/dev/null)
    fi
    if [ -f "$root/CHEAT-SHEET-ViScript.md" ]; then
        scan+=("$root/CHEAT-SHEET-ViScript.md")
    fi
    [ ${#scan[@]} -eq 0 ] && return 0
    if [ ! -f "$list" ]; then
        echo "R6 $(relpath "$list"): thiếu danh sách cấm (có tệp bị quét nhưng không có cu-cam.txt)" >&2
        return 1
    fi
    local out rc
    out=$(awk -v LIST="$list" -v EXC="$except" -v ROOT="$root" '
        function rel(p) { sub("^" ROOT "/", "", p); return p }
        BEGIN {
            n = 0
            while ((getline line < LIST) > 0) {
                if (line ~ /^[ \t]*($|#)/) continue
                split(line, a, "\t")
                w = a[1]; sub(/^[ \t]+|[ \t]+$/, "", w)
                if (w == "") continue
                if (w !~ /^[A-Za-z0-9_(]+$/) { printf "R6 %s: mục `%s` không hợp lệ (từ khoá ascii, tuỳ chọn hậu tố `(`)\n", LIST, w; bad = 1; continue }
                # Từ khoá kết thúc bằng `(` ⇒ không cần bờ phải (pattern `ok\(` khớp `ok(s)`);
                # bờ TRÁI loại cả `.` (method gọi kiểu `xs.some(f)` là hợp lệ — không phải pattern).
                if (w ~ /\($/) { wq = w; gsub(/\(/, "\\(", wq); pat[++n] = "([^A-Za-z0-9_.]|^)" wq }
                else pat[++n] = "([^A-Za-z0-9_.]|^)" w "([^A-Za-z0-9_]|$)"
                word[n] = w
            }
            close(LIST)
            if (bad) exit 2
            m = 0
            while ((getline line < EXC) > 0) {
                if (line ~ /^[ \t]*($|#)/) continue
                exc[++m] = tolower(line)
            }
            if (EXC != "") close(EXC)
        }
        {
            if (FILENAME != cur) { cur = FILENAME; relcur = rel(cur) }
            low = tolower($0)
            if (low ~ /cú pháp sai/) next
            for (j = 1; j <= m; j++) if (index(low, exc[j]) > 0) next
            for (i = 1; i <= n; i++) if ($0 ~ pat[i]) printf "R6 %s:%d: từ khoá bị bỏ ở pha 1 (`%s`) — dùng bản mới\n", relcur, FNR, word[i]
        }
    ' "${scan[@]}")
    rc=$?
    if [ $rc -eq 2 ]; then printf '%s\n' "$out" >&2; return 1; fi
    if [ -n "$out" ]; then printf '%s\n' "$out" >&2; return 1; fi
    return 0
}

# R5 (VD-195): bảng tóm tắt §8 của `agent/SO-NO.md` phải bằng **số đếm thật** của bảng nợ §4.
#   §4: mỗi hàng dữ liệu (cột 1 là số nợ) ⇒ phân loại cột 4 thành mở / đóng / chuyển VS3 /
#       không làm / điều hướng. §8: đọc bảng "Chỉ số | Số" ⇒ so từng chỉ số + tổng dòng.
#   Lệch ⇒ đỏ. Không có `agent/SO-NO.md` trong cây ⇒ bỏ qua (cây tạm của self-test R1..R4).
#   Một tiến trình `awk` cho cả hai bảng — không tạo tiến trình mỗi hàng.
rule_so_no() {
    local root="$1"
    local f="$root/agent/SO-NO.md"
    [ -f "$f" ] || return 0
    local kq
    kq="$(awk '
        function trim(s) { sub(/^[ \t]+/, "", s); sub(/[ \t]+$/, "", s); return s }
        function norm(s) { gsub(/[`*]/, "", s); return trim(s) }
        function firstint(s) { if (match(s, /[0-9]+/)) return substr(s, RSTART, RLENGTH) + 0; return -1 }
        function row(line) { sub(/^[ \t]*\|/, "", line); sub(/[ \t]*\|[ \t]*$/, "", line); return line }
        BEGIN { sec = 0; bad = "" }
        /^## [0-9]+\./ { sec = $2 + 0; next }
        sec == 4 && /^[ \t]*\|/ {
            line = row($0); n = split(line, c, "|")
            if (n < 4) next
            so = trim(c[1])
            if (so !~ /^[0-9]+[a-z]?$/) next
            st = norm(c[4]); total4++
            if (st ~ /^mở/) mo4++
            else if (st ~ /^đóng/) dong4++
            else if (st ~ /^chuyển VS3/) vs34++
            else if (st ~ /^không làm/) kl4++
            else if (st ~ /điều hướng/) dh4++
            else bad = bad "§4 hàng " so ": trạng thái lạ (" st "); "
            next
        }
        sec == 8 && /^[ \t]*\|/ {
            line = row($0); n = split(line, c, "|")
            if (n < 2) next
            lab = norm(c[1]); v = firstint(c[2])
            if (v < 0) next
            if (lab ~ /^Tổng/) { t8 = v; ht = 1 }
            else if (lab ~ /điều hướng/) { dh8 = v; hdh = 1 }
            else if (lab ~ /^không làm/) { kl8 = v; hkl = 1 }
            else if (lab ~ /^chuyển VS3/) { v8 = v; hv = 1 }
            else if (lab ~ /^đóng/) { d8 = v; hd = 1 }
            else if (lab ~ /^mở/) { m8 = v; hm = 1 }
            next
        }
        END {
            if (bad != "") { print "BAD " bad; exit }
            miss = ""
            if (!ht) miss = miss "Tổng dòng bảng chính; "
            if (!hm) miss = miss "mở; "
            if (!hd) miss = miss "đóng; "
            if (!hv) miss = miss "chuyển VS3; "
            if (!hkl) miss = miss "không làm có lý do; "
            if (!hdh) miss = miss "điều hướng; "
            if (miss != "") { print "BAD §8 thiếu hàng: " miss; exit }
            d = ""
            if (t8 != total4) d = d "tổng: §8 " t8 " ≠ §4 " total4 "; "
            if (m8 != mo4) d = d "mở: §8 " m8 " ≠ §4 " mo4 "; "
            if (d8 != dong4) d = d "đóng: §8 " d8 " ≠ §4 " dong4 "; "
            if (v8 != vs34) d = d "chuyển VS3: §8 " v8 " ≠ §4 " vs34 "; "
            if (kl8 != kl4) d = d "không làm: §8 " kl8 " ≠ §4 " kl4 "; "
            if (dh8 != dh4) d = d "điều hướng: §8 " dh8 " ≠ §4 " dh4 "; "
            if (d != "") { print "BAD " d; exit }
            print "OK"
        }' "$f" 2>/dev/null)" || kq="BAD không đọc được $f"
    case "$kq" in
        OK*) return 0 ;;
        "BAD "*) echo "R5 $(relpath "$f"): ${kq#BAD }" >&2; return 1 ;;
        *) echo "R5 $(relpath "$f"): máy kiểm §8 không chạy được ($kq)" >&2; return 1 ;;
    esac
}

# R7 (VD-282): cấm commit **mới** tệp log/txt > 50 KB trong `agent/JOURNAL/` (bằng chứng cổng phải
# là tóm tắt `.md` ≤ 15 KB + đường dẫn log ngoài repo + sha256). `test/gate/r7-legacy-logs.txt` là
# danh sách **đóng băng** các tệp lịch sử đã vượt ngưỡng — không thêm mới. **ST-310f**: các log
# tiền-`v0.4.0` đã chuyển sang `agent/archive/journal-pre-v040/`; danh sách giữ đường dẫn archive
# (không quét archive), nên R7 chỉ còn chặn tệp mới trong `agent/JOURNAL/`. Bỏ qua sidecar
# `*.license`. Không có `agent/JOURNAL/` (cây self-test R1..R4) ⇒ bỏ qua.
rule_journal_logs() {
    local root="$1"
    local dir="$root/agent/JOURNAL"
    local list="$root/test/gate/r7-legacy-logs.txt"
    [ -d "$dir" ] || return 0
    if [ ! -f "$list" ]; then
        echo "R7: thiếu $list (danh sách legacy đóng băng — VD-282)" >&2
        return 1
    fi
    local found=0 f rel
    while IFS= read -r f; do
        rel="${f#"$root"/}"
        case "$rel" in *.license) continue ;; esac
        if ! grep -Fxq "$rel" "$list"; then
            echo "R7 $rel: tệp .log/.log.*/.txt > 50 KB chưa có trong danh sách legacy (VD-282)" >&2
            found=1
        fi
    done < <(find "$dir" -maxdepth 1 -type f \( -name '*.log' -o -name '*.log.*' -o -name '*.txt' \) -size +50k 2>/dev/null)
    return "$found"
}

# R8 (ST-310e / ST-311c): chống phình test binary — (a) tối đa 15 tệp `.rs` cấp 1 ở
# `crates/vis-cli/tests/`, và (b) tổng số tệp `.rs` cấp 1 trong mọi `crates/*/tests/` ≤ 40
# (sau ST-311c giảm từ 78 → 34; ST-313c gộp `vis-fmt/moi` + `vish-edit/completion_job`
# ⇒ **36**). Ca mới nên vào `tests/<domain>/` + `#[path]` trong aggregator cấp 1.
# Không có `crates/` (cây self-test R1..R4) ⇒ bỏ qua.
rule_test_binaries() {
    local root="$1"
    local dir="$root/crates/vis-cli/tests"
    if [ -d "$dir" ]; then
        local n
        n=$(find "$dir" -maxdepth 1 -type f -name '*.rs' 2>/dev/null | wc -l | tr -d ' ')
        if [ "${n:-0}" -gt 15 ]; then
            echo "R8 crates/vis-cli/tests: $n binary > 15 (ST-310e: gom theo miền hoặc chuyển về crate chủ)" >&2
            return 1
        fi
    fi
    if [ -d "$root/crates" ]; then
        local tot
        tot=$(find "$root/crates" -mindepth 3 -maxdepth 3 -path '*/tests/*.rs' -type f 2>/dev/null | wc -l | tr -d ' ')
        if [ "${tot:-0}" -gt 40 ]; then
            echo "R8 crates/*/tests: tổng $tot binary > 40 (ST-311c: gom test binary theo miền)" >&2
            return 1
        fi
    fi
    return 0
}

# R9 (ST-310e): chỉ `vis-host-native` được chứa bản sao triển khai `openat2`. Danh sách ngoại lệ
# `test/gate/r9-openat2-ngoai-le.txt` đóng băng nợ tạm thời (hiện chỉ `vis-plugin-abi/src/cap_fs.rs`
# chờ ST-310c xoá); không thêm mục mới. Bỏ dòng chú thích trước khi quét để mention trong docs
# không bị bắt. Không có `crates/` ⇒ bỏ qua (cây self-test).
rule_openat2() {
    local root="$1"
    [ -d "$root/crates" ] || return 0
    local list="$root/test/gate/r9-openat2-ngoai-le.txt"
    if [ ! -f "$list" ]; then
        echo "R9: thiếu $list (danh sách ngoại lệ đóng băng — ST-310e)" >&2
        return 1
    fi
    local found=0 f rel
    while IFS= read -r f; do
        rel="${f#"$root"/}"
        case "$rel" in crates/vis-host-native/*) continue ;; esac
        if grep -Fxq "$rel" "$list"; then
            continue
        fi
        if sed 's://.*::' "$f" | grep -qE '(^|[^A-Za-z0-9_])openat2([^A-Za-z0-9_]|$)'; then
            echo "R9 $rel: bản sao openat2 ngoài crates/vis-host-native (ST-310e)" >&2
            found=1
        fi
    done < <(find "$root/crates" -type d -name target -prune -o -type f -name '*.rs' -print0 2>/dev/null | tr '\0' '\n')
    return "$found"
}

# R1..R9 trên một cây bất kỳ (dùng cho self-test với --root).
# **SỬA KÈM LÝ DO (VD-182, nợ #147)**: bản cũ tạo **một tiến trình cho mỗi tệp** — `wc`+`tr` cho R1,
# `awk` cho R2, `head`+`grep` cho R3 — và **ba** lượt `find` đi qua cả `target/` (2,2 GB, 433 000 tệp).
# macOS phạt tạo tiến trình 9,6× nên `rules` chậm 8,3× so với Linux. Nay: **một** lượt `find` (prune
# `target/`), `wc -l` gom theo lô 400 tệp, R2/R3 gom về **một** `awk`. Phép kiểm, ngưỡng, thứ tự báo
# lỗi và câu chữ giữ **nguyên văn**; chỉ giảm số tiến trình.
run_rules() {
    local root="$1"
    local found=0
    local f
    local -a files=()
    while IFS= read -r -d '' f; do
        files+=("$f")
    done < <(find "$root" -type d -name target -prune -o -type f -not -path '*/target/*' -print0 2>/dev/null)
    # R1: tệp nguồn ≤ 1.500 dòng
    local -a r1=()
    for f in "${files[@]}"; do
        case "$f" in
            *.rs | *.vis | *.vish | *.vidl | *.toml | *.sh | *.py) r1+=("$f") ;;
        esac
    done
    local i=0
    while [ "$i" -lt "${#r1[@]}" ]; do
        local -a lo=("${r1[@]:i:400}")
        local -a dem=()
        local line n k nd nl gom
        while IFS= read -r line; do dem+=("$line"); done < <(wc -l "${lo[@]}" 2>/dev/null)
        # `wc -l` in N dòng tệp + **một** dòng "total" khi N ≥ 2 (POSIX). Số dòng lệch ⇒
        # `wc` bỏ dòng (tệp không đọc được) hoặc tên tệp có xuống dòng ⇒ lùi về đếm từng tệp.
        nd=${#dem[@]}
        nl=${#lo[@]}
        gom=0
        if [ "$nl" -eq 1 ]; then
            [ "$nd" -eq 1 ] && gom=1
        else
            [ "$nd" -eq $((nl + 1)) ] && gom=1
        fi
        if [ "$gom" -eq 0 ]; then
            # Giữ nguyên hành vi cũ (một `wc` cho mỗi tệp) cho ca hiếm này.
            for f in "${lo[@]}"; do
                n=$(wc -l <"$f" | tr -d ' ')
                if [ "$n" -gt 1500 ]; then
                    echo "R1 $(relpath "$f"): $n dòng > 1500" >&2
                    found=1
                fi
            done
        else
            k=0
            for line in "${dem[@]}"; do
                [ "$k" -ge "$nl" ] && break
                n="${line#"${line%%[![:space:]]*}"}"
                n="${n%% *}"
                if [ "$n" -gt 1500 ]; then
                    echo "R1 $(relpath "${lo[$k]}"): $n dòng > 1500" >&2
                    found=1
                fi
                k=$((k + 1))
            done
        fi
        i=$((i + 400))
    done
    # R2: cấm `unsafe` ngoài danh sách crate đóng (hiện danh sách TRỐNG ở vòng 1)
    local -a r2=()
    for f in "${files[@]}"; do
        case "$f" in *.rs) r2+=("$f") ;; esac
    done
    if [ "${#r2[@]}" -gt 0 ]; then
        # Bỏ chú thích trước khi tìm từ khoá: nhắc chữ "unsafe" trong docs không phải vi phạm.
        local ln
        while IFS=$'\t' read -r ln f; do
            echo "R2 $(relpath "$f"):$ln: có 'unsafe' — vòng 1 chưa crate nào được phép" >&2
            found=1
        done < <(awk 'FNR == 1 { if (hit != "") { print hit "\t" prev; hit = "" } prev = FILENAME } hit == "" { s = $0; sub(/\/\/.*/, "", s); if (s ~ /(^|[^A-Za-z0-9_])unsafe([^A-Za-z0-9_]|$)/) hit = FNR } END { if (hit != "") print hit "\t" prev }' "${r2[@]}")
    fi
    # R3: SPDX theo loại tệp (QD §9.3)
    local -a r3=()
    for f in "${files[@]}"; do
        case "$f" in
            *.rs | *.s | *.asm | *.vis | *.vish | *.vidl | *.toml | *.sh | *.py) r3+=("$f") ;;
        esac
    done
    local -a thieu=()
    if [ "${#r3[@]}" -gt 0 ]; then
        # Một `awk` đọc 5 dòng đầu của **mọi** tệp cần SPDX (thay `head`+`grep` mỗi tệp).
        while IFS= read -r f; do thieu+=("$f"); done < <(printf '%s\n' "${r3[@]}" | awk '{ f = $0; ok = 0; for (j = 0; j < 5; j++) { if ((getline line < f) <= 0) break; if (line ~ /SPDX-License-Identifier/) { ok = 1; break } } close(f); if (!ok) print f }')
    fi
    # Duyệt `files` theo đúng thứ tự `find` cũ để câu báo lỗi ra **cùng thứ tự** (SPDX xen sidecar).
    local j=0
    local nt=${#thieu[@]}
    for f in "${files[@]}"; do
        case "$f" in
            *.rs | *.s | *.asm | *.vis | *.vish | *.vidl | *.toml | *.sh | *.py)
                if [ "$j" -lt "$nt" ] && [ "${thieu[$j]}" = "$f" ]; then
                    echo "R3 $(relpath "$f"): thiếu SPDX-License-Identifier trong 5 dòng đầu" >&2
                    found=1
                    j=$((j + 1))
                fi
                ;;
            *.json | *.bin | *.txt)
                if [ ! -f "$f.license" ]; then
                    echo "R3 $(relpath "$f"): tệp cần sidecar .license" >&2
                    found=1
                fi
                ;;
        esac
    done
    # R4: `vis-host-vifast` KHÔNG được nằm trong cây nguồn (QD §7.5, thiết kế §14.2)
    if [ -d "$root/vis-host-vifast" ] || [ -d "$root/crates/vis-host-vifast" ]; then
        echo "R4: vis-host-vifast nằm trong cây nguồn — phải ở workspace ngoài" >&2
        found=1
    fi
    # R5: §8 (tóm tắt sổ nợ) phải khớp §4 (bảng nợ chính) — VD-195.
    rule_so_no "$root" || found=1
    # R6: danh sách cấm (VD-205) — cú pháp bị bỏ ở pha 1 không được lọt vào docs/cheatsheet.
    rule_forbidden_list "$root" || found=1
    # R7: log bằng chứng > 50 KB trong agent/JOURNAL (VD-282).
    rule_journal_logs "$root" || found=1
    # R8: số integration-test binary cấp 1 của vis-cli (ST-310e ≤ 15).
    rule_test_binaries "$root" || found=1
    # R9: bản sao openat2 ngoài vis-host-native (ST-310e).
    rule_openat2 "$root" || found=1
    return "$found"
}

usage() {
    echo "dùng: vis-dev <check|gate --fast|core-test|nightly [--fuzz-minutes N] [--skip-gate]|doc-examples [--root DIR]|rules [--root DIR]>" >&2
    exit 2
}

do_doc_examples() {
    # Bước cổng "mọi khối mã trong tài liệu parse được" (QD §7.4, ST-09).
    #   $1 = đường dẫn python3 (rỗng ⇒ tự dò); $2 = gốc thay thế; $3 = --temp-root (case âm)
    local py="${1:-}"
    local root="${2:-}"
    if [ -z "$py" ]; then
        for c in python3.12 python3.11 python3; do
            if command -v "$c" >/dev/null 2>&1; then py="$c"; break; fi
        done
    fi
    if [ -z "$py" ]; then
        echo "vis-dev: không thấy python3 cho bước doc-examples" >&2
        return 1
    fi
    local args=(--gate)
    if [ -n "$root" ]; then args+=(--root "$root"); fi
    if [ "${3:-}" = "--temp-root" ]; then args+=(--temp-root); fi
    if ! "$py" "$VIS_ROOT/test/doc-examples/doc_examples.py" "${args[@]}"; then
        return 1
    fi
}

do_readme_examples() {
    # Khối mã trong README/CHEAT-SHEET không nằm trong cổng QD §7.4 (doc_examples.py
    # chỉ quét docs/*.md) ⇒ cần bước riêng, không đụng vào số liệu Agent 0 của cổng đó.
    local py="${1:-}"
    if [ -z "$py" ]; then
        for c in python3.12 python3.11 python3; do
            if command -v "$c" >/dev/null 2>&1; then py="$c"; break; fi
        done
    fi
    if [ -z "$py" ]; then
        echo "vis-dev: không thấy python3 cho bước readme-examples" >&2
        return 1
    fi
    if ! "$py" "$VIS_ROOT/test/readme-examples.py"; then
        return 1
    fi
}

do_check() {
    echo "== vis-dev check =="
    PY=""
    for c in python3.12 python3.11 python3; do
        if command -v "$c" >/dev/null 2>&1; then PY="$c"; break; fi
    done
    if [ -z "$PY" ]; then echo "--- báo cáo: FAIL (không thấy python3)"; return 1; fi
    if [ -z "$CARGO" ]; then echo "vis-dev: không thấy cargo" >&2; return 1; fi
    if ! "$CARGO" fmt --manifest-path "$MANIFEST" --all -- --check; then
        echo "--- fmt: FAIL" >&2; return 1
    fi
    echo "--- fmt: OK"
    if ! "$CARGO" clippy --manifest-path "$MANIFEST" --workspace --all-targets -- -D warnings; then
        echo "--- clippy: FAIL" >&2; return 1
    fi
    echo "--- clippy: OK"
    if ! run_rules "$VIS_ROOT"; then
        echo "--- luật R1..R9: FAIL" >&2; return 1
    fi
    echo "--- luật R1..R9: OK"
    # **VD-258** — pin toolchain/hạ tầng phải khớp `Cargo.toml`; test này từng không được cổng
    # gọi nên `1.99.1` lệch workspace `1.100.0` vẫn xanh.
    if ! bash "$VIS_ROOT/test/toolchain/run.sh"; then
        echo "--- toolchain: FAIL" >&2
        return 1
    fi
    echo "--- toolchain: OK"
    # **VD-259** — artifact phát hành chỉ có `vis`; `test-child` (bin test-support) không được lọt.
    # Phép kiểm nhanh (metadata + dry-run + staging với cargo giả), không build release trong gate.
    if ! bash "$VIS_ROOT/test/release/run.sh"; then
        echo "--- release: FAIL" >&2
        return 1
    fi
    echo "--- release: OK"
    if ! bash "$VIS_ROOT/test/fixtures/run_fixtures.sh"; then
        echo "--- self-test case âm: FAIL" >&2; return 1
    fi
    echo "--- self-test case âm: OK"
    if ! bash "$VIS_ROOT/bin/vis" explain VS0107 | grep -q "VS0107"; then
        echo "--- vis explain: FAIL" >&2; return 1
    fi
    echo "--- vis explain: OK"
    echo "--- báo cáo R*-viscript (Khối E)"
    if (cd "$REPO_ROOT" && PYTHON="$PY" "$PY" test/report/check_report.py --all); then
        echo "--- báo cáo: OK"
    else
        echo "--- báo cáo: FAIL" >&2; return 1
    fi
    echo "--- fixture âm của máy kiểm báo cáo"
    if (cd "$REPO_ROOT" && PYTHON="$PY" bash test/report/run_fixtures.sh); then
        echo "--- báo cáo fixtures: OK"
    else
        echo "--- báo cáo fixtures: FAIL" >&2; return 1
    fi
    if ! "$CARGO" build --manifest-path "$MANIFEST" --workspace; then
        echo "--- build: FAIL" >&2; return 1
    fi
    echo "--- build: OK"
    # Bước sau build: `vis check` phải dùng binary vừa build (không dùng bản cũ).
    if ! do_doc_examples "$PY"; then
        echo "--- doc-examples: FAIL" >&2
        return 1
    fi
    if ! do_readme_examples "$PY"; then
        echo "--- readme-examples: FAIL" >&2
        return 1
    fi
    echo "--- readme-examples: OK"
    echo "vis-dev check: PASS"
}

# **VD-259** — core test (`--no-default-features`) trong **target riêng**.
#   Integration test dùng `CARGO_BIN_EXE_vis` = `<target>/debug/vis`. Nếu dùng chung target với
#   gate default, một gate chạy song song/ngay trước có thể để lại (hoặc ghi đè giữa chừng) bản
#   `vis` default có sqlite ⇒ core test thấy binary sai cấu hình dù source/feature đúng. Target
#   riêng + build tường minh trước khi test loại hẳn cuộc đua đó; cargo test vẫn chạy lần lượt
#   từng test binary (mặc định), không chạy hai binary cùng lúc.
#   Không đặt `--test-threads=1`: song song trong một binary là chủ ý của bộ test và không liên
#   quan tới cuộc đua giữa hai cấu hình feature.
do_core_test() {
    echo "== vis-dev core-test =="
    if [ -z "$CARGO" ]; then
        echo "vis-dev: không thấy cargo" >&2
        return 1
    fi
    local core_target="${VIS_CORE_TARGET_DIR:-$VIS_ROOT/target/core-test}"
    case "$core_target" in
        /*) ;;
        *) core_target="$PWD/$core_target" ;;
    esac
    echo "vis-dev: core target riêng: $core_target"
    echo "--- core build (--no-default-features; --bin vis --bin test-child)"
    if ! CARGO_TARGET_DIR="$core_target" "$CARGO" build --manifest-path "$MANIFEST" \
        -p vis-cli --no-default-features --bin vis --bin test-child; then
        echo "--- core build: FAIL" >&2
        return 1
    fi
    echo "--- core build: OK"
    echo "--- core test (--no-default-features; sau build, từng test binary tuần tự)"
    if ! CARGO_TARGET_DIR="$core_target" "$CARGO" test --manifest-path "$MANIFEST" \
        -p vis-cli --no-default-features; then
        echo "--- core test: FAIL" >&2
        return 1
    fi
    echo "--- core test: OK"
    echo "vis-dev core-test: PASS (target: $core_target)"
}

# L0 test — **TỐI ƯU (ST-258)**: `cargo test` chạy các test binary tuần tự (đo 43,78 s với
# 1435 test/12 core). `cargo nextest run` chạy song song, mỗi ca một process ⇒ ~8,4 s, nhưng
# **không chạy doc-test** ⇒ phải thêm `cargo test --doc` (5 ca). Tổng 1430+5 = 1435 như cũ.
# nextest là tuỳ chọn: máy chưa cài thì fallback y hệt lệnh cũ; `VIS_NO_NEXTEST=1` để tắt khi
# cần đối chiếu. Không đổi kỳ vọng, không bỏ ca, không đổi mã thoát.
run_l0_tests() {
    if [ "${VIS_NO_NEXTEST:-0}" != "1" ] && command -v cargo-nextest >/dev/null 2>&1; then
        echo "--- L0 test: cargo-nextest (song song) + doc-test"
        "$CARGO" nextest run --manifest-path "$MANIFEST" --workspace &&
            "$CARGO" test --manifest-path "$MANIFEST" --workspace --doc
        return $?
    fi
    "$CARGO" test --manifest-path "$MANIFEST" --workspace
}

do_gate_fast() {
    do_check || return 1
    if ! run_l0_tests; then
        echo "--- L0 test: FAIL" >&2; return 1
    fi
    echo "--- L0 test: OK"
    echo "vis-dev gate --fast: PASS (L1 chưa có tới khi có sim ViScript)"
}

# Vòng tròn fmt: `vis fmt` phải **bất động** (fmt(fmt(x)) == fmt(x)) trên mọi ca ngữ nghĩa.
# **TỐI ƯU (ST-257)**: bản cũ gọi `vis fmt` **2 lần cho mỗi tệp** — 475 tệp ⇒ ~950 lần spawn
# tiến trình (macOS phạt spawn ~9,6×, xem comment R1..R9 ở đầu tệp). Nay copy ca vào một thư
# mục tạm rồi dùng **đúng 2 lệnh**: `fmt --write <tmp>` cho `a := fmt(f)`, `fmt --check <tmp>`
# so `fmt(a)` với `a`. Phép kiểm/ngưỡng/số tệp/câu chữ giữ nguyên; chỉ giảm số lần spawn.
do_vong_tron_fmt() {
    local vis="$VIS_ROOT/target/debug/vis"
    if [ ! -x "$vis" ]; then
        echo "--- vòng tròn fmt: FAIL (chưa có $vis — chạy build trước)" >&2
        return 1
    fi
    local n=0 bad=0 bo_qua=0 copied=0
    local tmp f rel name
    tmp="$(mktemp -d "${TMPDIR:-/tmp}/visfmt.XXXXXX")" || return 1
    while IFS= read -r -d '' f; do
        n=$((n + 1))
        # Ca **cố ý hỏng cú pháp** (có `.err`) thì `vis fmt` phải lỗi — bỏ qua, không tính là hỏng.
        if [ -f "${f%.vis}.err" ]; then
            bo_qua=$((bo_qua + 1))
            continue
        fi
        rel="${f#"$VIS_ROOT"/test/sem/}"
        name="${rel//\//__}"
        if ! cp "$f" "$tmp/$name" 2>/dev/null; then
            echo "--- vòng tròn fmt: không copy được $f" >&2
            bad=$((bad + 1))
            continue
        fi
        copied=$((copied + 1))
    done < <(find "$VIS_ROOT/test/sem" -type f -name '*.vis' -print0 2>/dev/null)
    if [ "$copied" -gt 0 ]; then
        if ! "$vis" fmt --write "$tmp" >/dev/null 2>&1; then
            echo "--- vòng tròn fmt: FAIL (fmt --write trên bản sao)" >&2
            bad=$((bad + 1))
        elif ! "$vis" fmt --check "$tmp" >/dev/null 2>&1; then
            echo "--- vòng tròn fmt: KHÔNG bất động (fmt --check trên bản sao)" >&2
            bad=$((bad + 1))
        fi
    fi
    rm -rf "$tmp"
    if [ "$bad" -ne 0 ]; then
        echo "--- vòng tròn fmt: FAIL ($bad/$n tệp, bỏ qua $bo_qua)" >&2
        return 1
    fi
    echo "--- vòng tròn fmt: OK ($n tệp, bất động; bỏ qua $bo_qua ca lỗi cú pháp)"
}

# Fuzz **parser** (ST-16): chạy `vis-parse-fuzz` với số phút cho trước; vi phạm ⇒ FAIL.
do_fuzz_parser() {
    local phut="$1"
    # **VD-283 / ST-298**: tôn trọng `CARGO_TARGET_DIR` (nightly trước đây gọi cứng
    # `target/release/...` nên đỏ khi target dir là đường khác — `nightly-8286caf.md` §2).
    local bin="${CARGO_TARGET_DIR:-$VIS_ROOT/target}/release/vis-parse-fuzz"
    if [ ! -x "$bin" ]; then
        if ! "$CARGO" build --release --manifest-path "$MANIFEST" -p vis-syntax --bin vis-parse-fuzz; then
            echo "--- fuzz parser: FAIL (không build được)" >&2
            return 1
        fi
    fi
    local giay=$((phut * 60))
    echo "--- fuzz parser: ${phut} phút (${giay}s)"
    if ! "$bin" --seconds "$giay" --seed "$(date +%Y%m%d)"; then
        echo "--- fuzz parser: FAIL" >&2
        return 1
    fi
    echo "--- fuzz parser: OK"
}

do_nightly() {
    local phut=2
    local bo_qua_gate=0
    local i=2
    while [ "$i" -le "$#" ]; do
        case "${!i}" in
            --fuzz-minutes)
                i=$((i + 1))
                phut="${!i:-}"
                ;;
            # **ST-257**: khi đã chạy `gate --fast` ngay trước đó, bỏ qua lần chạy lại —
            # `cargo test --workspace` chiếm ~44 s (đo hôm nay). Cờ này **chỉ** bỏ bước gate;
            # fuzz và vòng tròn fmt vẫn chạy đủ. Không đổi hành vi mặc định.
            --skip-gate)
                bo_qua_gate=1
                ;;
            *)
                echo "vis-dev: nightly không hiểu \`${!i}\`" >&2
                return 2
                ;;
        esac
        i=$((i + 1))
    done
    case "$phut" in
        '' | *[!0-9]*)
            echo "vis-dev: --fuzz-minutes cần số nguyên (phút)" >&2
            return 2
            ;;
    esac
    if [ "$bo_qua_gate" -eq 0 ]; then
        do_gate_fast || return 1
    else
        echo "--- gate --fast: BỎ QUA (--skip-gate; fuzz + vòng tròn fmt vẫn chạy)"
    fi
    do_fuzz_parser "$phut" || return 1
    do_vong_tron_fmt || return 1
    echo "vis-dev nightly: PASS"
}

case "${1:-}" in

    check) do_check ;;
    core-test) do_core_test ;;
    gate)
        [ "${2:-}" = "--fast" ] || { echo "vis-dev: chỉ 'gate --fast' ở vòng 1" >&2; exit 2; }
        do_gate_fast
        ;;
    nightly)
        do_nightly "$@"
        ;;
    doc-examples)
        root=""
        temp=""
        i=2
        while [ "$i" -le "$#" ]; do
            case "${!i}" in
                --root) i=$((i + 1)); root="${!i:-}" ;;
                --temp-root) temp="--temp-root" ;;
            esac
            i=$((i + 1))
        done
        if ! do_doc_examples "" "$root" "$temp"; then
            echo "--- doc-examples: FAIL" >&2
            exit 1
        fi
        ;;
    rules)
        root="$VIS_ROOT"
        if [ "${2:-}" = "--root" ] && [ -n "${3:-}" ]; then root="$3"; fi
        run_rules "$root" && echo "--- rules: OK"
        ;;
    *) usage ;;
esac
