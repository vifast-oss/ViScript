#!/usr/bin/env bash
# SPDX-License-Identifier: MIT OR Apache-2.0
# Chạy `vis` từ workspace (chưa cài vào PATH ở vòng 1).
# **Nợ #185 (VD-241/VD-246)**: lệnh chuẩn phải tự chọn đúng toolchain hoặc thất bại rõ —
# không dựa vào người dùng sửa PATH ngầm (trước đây `vis test` rơi vào rustc 1.93.1).
set -u
# **SỬA KÈM LÝ DO (verify psvn)**: dùng bash thuần thay `dirname` ngoài — ca fixture #5
# chạy `bin/vis` với `env -i PATH=<sạch>`; trên Git Bash `dirname` trả rỗng ⇒ VIS_ROOT="/"
# ⇒ source sai `//bin/_vis-toolchain.sh`. `${0%/*}` là builtin, chạy được mọi nền.
case "$0" in
    */*) _vis_dir="${0%/*}" ;;
    *)   _vis_dir="." ;;
esac
VIS_ROOT="$(cd "$_vis_dir/.." && pwd)"
# shellcheck source=_vis-toolchain.sh
source "$VIS_ROOT/bin/_vis-toolchain.sh"

CARGO="$(vis_find_cargo "vis")" || exit 78
echo "vis: chọn cargo $CARGO ($(vis_semver_of "$CARGO" || true); yêu cầu ≥ $(vis_required_rust_version))" >&2
exec "$CARGO" run -q --manifest-path "$VIS_ROOT/Cargo.toml" -p vis-cli --bin vis -- "$@"
