#!/bin/sh
# SPDX-License-Identifier: MIT OR Apache-2.0
# ST-113/VD-116 — soak tuần tự 10 vòng (ST-98 mở rộng: thêm gate-3 + diff-3) (KHÔNG chạy song song build/cổng khác — AGENTS §6).
# Không retry: vòng đỏ ⇒ ghi rõ + dừng (T-INFRA nếu do tải máy).
#
# ST-141/VD-147(5) — log bằng chứng KHÔNG ghi đè:
#   Cách dùng: bin/vis-soak [--log <tệp>] [--append] [--dry-run]
#              VIS_SOAK_LOG=<tệp> VIS_SOAK_APPEND=1 bin/vis-soak
#   Chọn tệp log (ưu tiên giảm dần): `--log <tệp>` > `VIS_SOAK_LOG` > mặc định theo ID task:
#     · có `VIS_TASK_ID` ⇒ `agent/JOURNAL/st<ID>-soak.log` (ví dụ ST-143 ⇒ `st143-soak.log`);
#     · không có ID    ⇒ `agent/JOURNAL/soak-<YYYYmmddTHHMMSSZ>.log` (mốc UTC, không trùng lần chạy khác).
#   Tệp đích đã tồn tại và KHÁC RỖNG ⇒ in lỗi ra stderr, exit 2, **không** truncate, **không** ghi gì;
#   chỉ ghi tiếp khi có `--append` (hoặc `VIS_SOAK_APPEND=1`).
#   `--dry-run` in đúng 10 tên vòng ra stdout, KHÔNG chạy soak, KHÔNG tạo/ghi tệp log — nhưng vẫn kiểm
#   nhánh từ chối ở trên để thử được mà không phải soak thật.
#   Vì sao cấm ghi đè: bản trước ghi cứng `agent/JOURNAL/st113-soak.log` và `: >` đầu mỗi lần chạy, nên
#   log soak vòng 20 (ST-113) bị xoá 2 lần bởi ST-133 (`739f6e69`) và ST-138 (`a9f80d83`); ST-141 phải
#   khôi phục từ git. Mỗi lần chạy công cụ dài phải để lại bằng chứng riêng, không xoá bằng chứng task khác.
set -u
# `cargo` không nằm trong PATH của shell không đăng nhập (background job) — bổ sung tường minh.
PATH="${HOME}/.cargo/bin:/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin:${PATH:-}"
export PATH
cd "$(dirname "$0")/.." || exit 2
LOG="${VIS_SOAK_LOG:-}"
APPEND=0
DRY=0
if [ "${VIS_SOAK_APPEND:-0}" = "1" ]; then
    APPEND=1
fi
while [ $# -gt 0 ]; do
    case "$1" in
        --dry-run) DRY=1 ;;
        --append) APPEND=1 ;;
        --log)
            shift
            if [ $# -eq 0 ] || [ -z "$1" ]; then
                echo "vis-soak: --log cần <tệp>" >&2
                exit 2
            fi
            LOG=$1
            ;;
        --log=*)
            LOG=${1#--log=}
            if [ -z "$LOG" ]; then
                echo "vis-soak: --log cần <tệp>" >&2
                exit 2
            fi
            ;;
        *)
            echo "vis-soak: đối số không hiểu: $1 (dùng --log <tệp> | --append | --dry-run)" >&2
            exit 2
            ;;
    esac
    shift
done
# Mặc định KHÔNG trùng log của task khác (VD-147(5)): ưu tiên --log > VIS_SOAK_LOG > tên theo ID task.
if [ -z "$LOG" ]; then
    if [ -n "${VIS_TASK_ID:-}" ]; then
        LOG="agent/JOURNAL/st${VIS_TASK_ID}-soak.log"
    else
        LOG="agent/JOURNAL/soak-$(date -u +%Y%m%dT%H%M%SZ).log"
    fi
fi

# ST-143: `VIS_SOAK_LOG`/`VIS_SOAK_APPEND` là **cấu hình của script này**, không được rò vào lệnh con.
# Vòng `gate-*` chạy `cargo test` ⇒ ca `soak_script` gọi lại `bin/vis-soak --dry-run` với môi trường kế thừa;
# tệp log đang ghi (khác rỗng) ⇒ nhánh từ chối ghi đè exit 2 ⇒ L0 đỏ **tất định** (ST-143 lần 1: gate-1 31 s,
# L0 1161/1, đúng ca `vis_soak_hop_le_va_in_du_10_vong`; log `st143-soak-lan1-gate-1-do.log`). Bỏ hai biến
# sau khi đã đọc xong giá trị; `--log`/`--append` không bị ảnh hưởng.
unset VIS_SOAK_LOG VIS_SOAK_APPEND

# Từ chối ghi đè: tệp đích đã tồn tại và khác rỗng ⇒ exit 2, KHÔNG truncate (chỉ ghi tiếp khi --append).
kiem_ghi_de() {
    if [ "$APPEND" -eq 1 ]; then
        return 0
    fi
    if [ -s "$LOG" ]; then
        echo "vis-soak: TỪ CHỐI ghi đè '$LOG' ($(wc -c <"$LOG" | tr -d ' ') byte) — VD-147(5): log bằng chứng không được ghi đè." >&2
        echo "vis-soak: dùng --log <tệp khác> hoặc VIS_SOAK_LOG; muốn ghi tiếp tệp này thì thêm --append / VIS_SOAK_APPEND=1." >&2
        exit 2
    fi
}

if [ "$DRY" -eq 1 ]; then
    kiem_ghi_de
    printf '%s\n' gate-1 gate-2 gate-3 diff-1 diff-2 diff-3 host-1 host-2 cache-1 cache-2
    exit 0
fi

kiem_ghi_de
mkdir -p "$(dirname "$LOG")" || exit 2
if [ "$APPEND" -ne 1 ]; then
    : >"$LOG"
fi
echo "vis-soak: log: $LOG" >&2
tong=0
truoc=$(uptime)
head=$(git rev-parse --short HEAD 2>/dev/null)
{
    echo "# ST-113 — soak 10 vòng, bắt đầu $(date -u +%Y-%m-%dT%H:%M:%SZ), HEAD ${head:-?}"
    echo "# log: $LOG · ID task: ${VIS_TASK_ID:-?} · chế độ: $([ "$APPEND" -eq 1 ] && echo ghi-tiếp || echo tệp-mới)"
    echo "# load trước: $truoc"
} | tee -a "$LOG"

chay() {
    ten=$1
    shift
    bat=$(date +%s)
    bat_iso=$(date -u +%Y-%m-%dT%H:%M:%SZ)
    echo "=== $ten | bắt đầu $bat_iso" | tee -a "$LOG"
    "$@" >>"$LOG" 2>&1
    ma=$?
    het=$(date +%s)
    het_iso=$(date -u +%Y-%m-%dT%H:%M:%SZ)
    giay=$((het - bat))
    tong=$((tong + giay))
    if [ "$ma" -eq 0 ]; then
        cl="OK"
    else
        cl="ĐỎ (exit $ma)"
    fi
    echo "=== $ten | kết thúc $het_iso | ${giay}s | exit=$ma | KẾT LUẬN: $cl" | tee -a "$LOG"
    if [ "$ma" -ne 0 ]; then
        echo "soak: DỪNG ở $ten — KHÔNG retry; nếu do tải máy ghi T-INFRA (load: $(uptime))" | tee -a "$LOG"
        exit "$ma"
    fi
}

chay gate-1 ./vis-dev gate --fast
chay gate-2 ./vis-dev gate --fast
chay diff-1 env VIS_DIFF_N=100000 VIS_DIFF_SEED=20261115 ./bin/vis-diff
chay diff-2 env VIS_DIFF_N=100000 VIS_DIFF_SEED=20261115 ./bin/vis-diff
chay gate-3 ./vis-dev gate --fast
chay diff-3 env VIS_DIFF_N=100000 VIS_DIFF_SEED=20261115 ./bin/vis-diff
chay host-1 ./bin/vis-host-suite
chay host-2 ./bin/vis-host-suite
chay cache-1 cargo test -p vis-cli --test cache_khong_che
chay cache-2 cargo test -p vis-cli --test cache_khong_che

sau=$(uptime)
echo "=== TỔNG | ${tong}s | 10/10 vòng OK | load sau: $sau" | tee -a "$LOG"
